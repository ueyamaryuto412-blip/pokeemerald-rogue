script Rogue_Tutor_TutorMoveLearn
{
    special(TeachMoveSetContextTutorMove)
    lock
    faceplayer
    msgbox(format("{JPN}ハッ!\p おれは わざの せんせいだ!\p ポケモンに すごい わざを おしえられる!\pさあ なにを おしえようか?"), MSGBOX_DEFAULT)

    setvar(VAR_0x8004, 0)
    special(TeachMoveFromContext)
    waitstate

    release
}

script Rogue_Tutor_MoveDelete
{
    lock
    faceplayer
    msgbox(format("{JPN}ああ…\nそうだ わしは わざわすれ じいさん。\pのぞむなら ポケモンに わざを\nわすれさせられるが どうかね?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == NO)
    {
        goto(Rogue_Tutor_MoveDeleteCancel)
    }

    special(ChoosePartyMon)
    waitstate
    if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
    {
        goto(Rogue_Tutor_MoveDeleteCancel)
    }

    special(IsSelectedMonEgg)
    if(var(VAR_RESULT) == TRUE)
    {
        goto(Rogue_Tutor_MoveDeleteEgg)
    }

    special(GetNumMovesSelectedMonHas)
    if(var(VAR_RESULT) <= 1)
    {
        goto(Rogue_Tutor_MoveDeleteNoMoves)
    }

    fadescreen(FADE_TO_BLACK)
    special(MoveDeleterChooseMoveToForget)
    fadescreen(FADE_FROM_BLACK)

    if(var(VAR_0x8005) == MAX_MON_MOVES)
    {
        goto(Rogue_Tutor_MoveDeleteCancel)
    }

    special(MoveDeleterForgetMove)
    playfanfare(MUS_MOVE_DELETED)
    waitfanfare

    release
}

script Rogue_SpeakDaycareLady
{
    lock
    faceplayer
    msgbox(format("{JPN}あら いらっしゃい!\nそだてやの おばさんですよ。\pよければ ポケモンを あずかりますよ。"), MSGBOX_DEFAULT)

    message(format("{JPN}どの {PKMN}の わくに しますか?"))
    waitmessage

    multichoice(1, 1, MULTI_ROGUE_DAYCARE, NO)

    switch(var(VAR_RESULT))
    {
        case MULTI_B_PRESSED:
            setvar(VAR_RESULT, NO)

        default:
            copyvar(VAR_0x8005, VAR_RESULT)
            call(Rogue_SpeakDaycareLady_TrySwapMon)
    }

    release
}

script Rogue_SpeakDaycareLady_TrySwapMon
{
    special(Rogue_IsDaycareSlotEmpty)
    if(var(VAR_RESULT) == YES)
    {
        setvar(VAR_RESULT, NO)
        specialvar(VAR_0x8008, CalculatePlayerPartyCount)

        if(var(VAR_0x8008) == 1)
        {
            msgbox(format("{JPN}いまは これいじょう あずかれません。\pあずけると てもちが\nいなく なって しまいます!"), MSGBOX_DEFAULT)
        }
        else
        {
            msgbox(format("{JPN}どの ポケモンを あずけますか?"), MSGBOX_DEFAULT)
            fadescreen(FADE_TO_BLACK)
            special(ChooseSendDaycareMon)
            waitstate

            if(var(VAR_0x8004) != PARTY_NOTHING_CHOSEN)
            {
                if(var(VAR_0x8004) == 0)
                {
                    call(Rogue_ScriptHideFollower)
                }

                setvar(VAR_0x8006, 1)
                special(Rogue_SwapDaycareMon)

                if(var(VAR_0x8004) == 0)
                {
                    call(Rogue_ScriptShowFollower)
                }
                msgbox(format("{JPN}だいじに あずかりますね!\pいってらっしゃい!"), MSGBOX_DEFAULT)
                setvar(VAR_RESULT, YES)
            }
        }
    }
    else
    {
        setvar(VAR_RESULT, NO)

        specialvar(VAR_0x8008, CalculatePlayerPartyCount)
        specialvar(VAR_0x8009, Rogue_CalcMaxPartySize)
        
        if(var(VAR_0x8008) >= VAR_0x8009)
        {
            msgbox(format("{JPN}ポケモンを ひきとりたいのですね?\pてもちが いっぱいの ようです!\pひきとるには てもちから 1ぴき\nあずけて いただく ひつようが あります。"))
            fadescreen(FADE_TO_BLACK)
            special(ChooseSendDaycareMon)
            waitstate

            if(var(VAR_0x8004) != PARTY_NOTHING_CHOSEN)
            {
                if(var(VAR_0x8004) == 0)
                {
                    call(Rogue_ScriptHideFollower)
                }

                setvar(VAR_0x8006, 1)
                special(Rogue_SwapDaycareMon)

                if(var(VAR_0x8004) == 0)
                {
                    call(Rogue_ScriptShowFollower)
                }
                msgbox(format("{JPN}だいじに あずかりますね!\pいってらっしゃい!"), MSGBOX_DEFAULT)
                setvar(VAR_RESULT, YES)
            }
        }
        else
        {
            msgbox(format("{JPN}ポケモンを ひきとりますか?"), MSGBOX_YESNO)

            if(var(VAR_RESULT) == YES)
            {
                setvar(VAR_0x8004, 5)
                setvar(VAR_0x8006, 1)
                special(Rogue_SwapDaycareMon)
                msgbox(format("{JPN}はい どうぞ!\pいってらっしゃい!"), MSGBOX_DEFAULT)
            }
        }
    }
}

