const FLAG_CAN_GIVE_C_GEAR = FLAG_TEMP_10

const VAR_TRIGGER_POKABBIE_MEET = VAR_TEMP_0

// Reused vars
const VAR_SHAKE_VERTICAL_PAN = VAR_0x8004
const VAR_SHAKE_HORIZONTAL_PAN = VAR_0x8005
const VAR_SHAKE_NUM_SHAKES = VAR_0x8006
const VAR_SHAKE_SHAKE_DELAY = VAR_0x8007

const OBJ_EVENT_POKABBIE = 2

mapscripts Rogue_Interior_ConfigLab_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Interior_ConfigLab_OnLoad
}

script Rogue_Interior_ConfigLab_OnLoad
{
    setvar(VAR_FOLLOW_MON_0, SPECIES_MAREEP)
    if(flag(FLAG_ROGUE_UNCOVERRED_POKABBIE))
    {
        call(Rogue_Interior_ConfigLab_DrawBasementDoor)
    }

    if(var(VAR_ROGUE_INTRO_STATE) >= ROGUE_INTRO_STATE_REPORT_TO_PROF && flag(FLAG_ROGUE_MET_FENNEL))
    {
        setflag(FLAG_CAN_GIVE_C_GEAR)
    }
    else
    {
        clearflag(FLAG_CAN_GIVE_C_GEAR)
    }

    if(!flag(FLAG_ROGUE_MET_POKABBIE))
    {
        setvar(VAR_TRIGGER_POKABBIE_MEET, YES)
    }
    else
    {
        setvar(VAR_TRIGGER_POKABBIE_MEET, NO)
    }
}

script Rogue_Interior_ConfigLab_DrawBasementDoor
{
    setmetatile(2, 13, 0x27C, TRUE)
    setmetatile(3, 13, 0x27D, TRUE)
    setmetatile(4, 13, 0x27E, TRUE)

    setmetatile(2, 14, 0x284, TRUE)
    setmetatile(3, 14, 0x283, FALSE)
    setmetatile(4, 14, 0x286, TRUE)

    setmetatile(2, 15, 0x28C, TRUE)
    setmetatile(4, 15, 0x28E, FALSE)
    special(DrawWholeMapView)
}

script Rogue_Interior_ConfigLab_TalkHiddenDoor
{
    special(Rogue_IsMultiplayerClient)
    if(flag(FLAG_ROGUE_UNCOVERRED_POKABBIE) == FALSE && var(VAR_RESULT) == NO)
    {
        lock

        msgbox(format("{JPN}なんだこれ?\pかくしスイッチだ!\pスイッチを おしますか?"), MSGBOX_YESNO)

        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("{JPN}けいこく!\nこのスイッチを おすと クリアご\lようそが さきに かいほうされる。\pふつうに 1かい クリアしてから\nおすことを おすすめする。\pスイッチを おしますか?"), MSGBOX_YESNO)

            if(var(VAR_RESULT) == YES)
            {
                setflag(FLAG_ROGUE_UNCOVERRED_POKABBIE)

                waitse
                playse(SE_TRUCK_DOOR)
                call(Rogue_Interior_ConfigLab_DrawBasementDoor)
            }
        }

        release
    }
}

script Rogue_Interior_ConfigLab_TalkFennel
{
    lock
    faceplayer
    msgbox(format("{JPN}マコモ: あら {PLAYER}!"), MSGBOX_DEFAULT)
    
    if(!flag(FLAG_ROGUE_MET_FENNEL))
    {
        msgbox(format("{JPN}すこし おちついたので やっと けんきゅうを つづけられるわ。\pけんきゅうの むきを かえたの。\nいまは ひとが ぼうけんに でている あいだ そとで なにが おきているかを しらべているの。"))
        msgbox(format("{JPN}ぼうけんと いえば…\pぼうけんの ふるまいを ちょうせいする ほうほうが わかったの。\pほら みてみて!"))
    }
    else
    {
        checkitem(ITEM_C_GEAR)

        if(var(VAR_RESULT) == FALSE && flag(FLAG_CAN_GIVE_C_GEAR))
        {
            msgbox(format("{JPN}あいたかった トレーナーだわ!\pわたす ものが あるの!"), MSGBOX_DEFAULT)

            giveitem(ITEM_C_GEAR)

            bufferitemname(STR_VAR_1, ITEM_C_GEAR)
            msgbox(format("{JPN}その {STR_VAR_1}を かいぞうして はなれた ばしょから せっていラボの せっていを みたり かえたり できるように したの!\pぼうけんちゅうでも せっていを かくにんできるわ!\pそれで…\nぼうけんの せっていを ちょうせいする?"), MSGBOX_DEFAULT)
        }
        else
        {
            msgbox(format("{JPN}ぼうけんの せっていを ちょうせいする?"), MSGBOX_DEFAULT)
        }
    }

    waitse
    special(Special_ViewDifficultyConfigMenu)
    waitstate

    if(!flag(FLAG_ROGUE_MET_FENNEL))
    {
        setflag(FLAG_ROGUE_MET_FENNEL)
        msgbox(format("{JPN}わたしも まだ ぜんぶは わかっていないの。\pでも あなたが たんけんを つづけてくれれば いつか データが たまって ぼうけんの ひみつを ときあかして おしえられるはず!"))
    }

    msgbox(format("{JPN}また ぼうけんの せっていを かえたく なったら こえを かけてね。")) 

    release
}

script Rogue_Interior_ConfigLab_TriggerMeetPokabbie
{
    lock
    setflag(FLAG_ROGUE_MET_POKABBIE)
    setvar(VAR_TRIGGER_POKABBIE_MEET, NO)

    applymovement(OBJ_EVENT_POKABBIE, Rogue_Interior_ConfigLab_Pokabbie0)
    waitmovement(0)

    playbgm(MUS_PL_MYSTERY_GIFT, TRUE)

    msgbox(format("{JPN}{PLAYER}!?\pこんなに はやく くるとは おもわなかった なにを しているんだ?\pぼくが だれかって?\pなまえは ポカビー。\nエメラルドローグの かいはつしゃだ!"))
    closemessage

    applymovement(OBJ_EVENT_POKABBIE, Pokabbie_Spin_FaceLeft)
    waitmovement(0)

    msgbox(format("{JPN}ポカビー: じゃーん!\pしょうじき チャンピオンに なって でんどういりした あとに はなすと おもっていたよ。\pまあ じゅんばんを とばしても いいか…\nセリフを おもいだそう。\pえほん。\p{FONT_NARROW}もうすぐ なるであろう{FONT_NORMAL} チャンピオンの きみには もっと たくさんの たのしみが まっている!\pそういえば…\nポケモンずかんを ちょっと かして。"))

    if(!flag(FLAG_SYS_POKEDEX_GET))
    {
        msgbox(format("{JPN}えっ?\pまだ ポケモンずかんも もっていない!?\pうわ… きみ ほんとうに せっかちだね?\pまあ これを あげるよ。"))
        
        callnative(Rogue_PushPopup_UnlockPokedex)
        call(Rogue_Common_DisplayPopups)
        setflag(FLAG_SYS_POKEDEX_GET)

        msgbox(format("{JPN}{FONT_NARROW}これで かたづいた セリフの つづきを…{FONT_NORMAL}\pポケモンずかんを ちょっと かして。"))
    }

    closemessage
    applymovement(OBJ_EVENT_POKABBIE, Rogue_Interior_ConfigLab_Pokabbie1)
    waitmovement(0)

    delay(30)
    playse(SE_M_COMET_PUNCH)
    waitse
    playse(SE_M_COMET_PUNCH)
    waitse
    playse(SE_M_COMET_PUNCH)
    waitse
    delay(30)

    playse(SE_M_EXPLOSION)
    setvar(VAR_SHAKE_VERTICAL_PAN, -5)
    setvar(VAR_SHAKE_HORIZONTAL_PAN, 5)
    setvar(VAR_SHAKE_NUM_SHAKES, 8)
    setvar(VAR_SHAKE_SHAKE_DELAY, 4)
    special(ShakeCameraNoSE)
    waitstate
    waitse

    delay(30)

    applymovement(OBJ_EVENT_POKABBIE, Rogue_Interior_ConfigLab_Pokabbie2)
    waitmovement(0)

    msgbox(format("{JPN}ポカビー: ふう…\nできた!\pいくつか かいりょうしておいたよ!\pまず ポケモンずかんの モードを\nちほうごとに かえられるように なった。\pほら みてごらん。"))

    waitse
    special(Special_ViewRoguePokedex)
    waitstate

    msgbox(format("{JPN}ずかんの モードを かえると つぎの ぼうけんでは その ずかんに いる ポケモンしか でてこなく なる!\pつぎに せっていラボも かいりょうしておいた!"))

    checkitem(ITEM_C_GEAR)
    if(var(VAR_RESULT) == NO)
    {
        bufferitemname(STR_VAR_1, ITEM_C_GEAR)

        msgbox(format("{JPN}なんだって!?\nじぶんの {STR_VAR_1}を もってない?\pそれは いけない!\nこれを どうぞ!"))
        giveitem(ITEM_C_GEAR)

        msgbox(format("{JPN}{STR_VAR_1}を つかうと どこからでも せっていラボを つかえる!\p{POKEMON_HUB}の どこでも せっていを かえられるし ぼうけんの とちゅうでも かくにんできる。\pおっと はなしが それた!\pかいりょうしたのは そこじゃ ないんだ…"))
    }

    msgbox(format("{JPN}せっていラボに あたらしい せっていを ふやしておいた。\pほら みてごらん。"))

    waitse
    special(Special_ViewDifficultyConfigMenu)
    waitstate

    msgbox(format("{JPN}そしてええええ!\pさいごに {POKEMON_HUB}に たてられる あたらしい しせつ チャレンジエリアを ついかした!"))

    if(var(VAR_ROGUE_INTRO_STATE) <= ROGUE_INTRO_STATE_LEARN_TO_BUILD)
    {
        msgbox(format("{JPN}しまった!\nまだ かいちくを ならっていない?\pはやく はなしかけすぎて チュートリアルが おわっていないんだ!\pまあ いい。\nさいしょの ぼうけんから もどれば すぐ わかるよ。"))
    }

    msgbox(format("{JPN}ネタバレは しないけど チャレンジエリアには きっと たのしい ものが たくさん あるよ!\pさあ ぼうけんに いって クリアしておいで!"))

    fadedefaultbgm
    release
}

script Rogue_Interior_ConfigLab_TalkPokabbie
{
    lock

    applymovement(OBJ_EVENT_POKABBIE, Pokabbie_Spin_FaceDown)
    waitmovement(0)

    faceplayer

    special(Rogue_CanActivatePikinEasterEgg)

    if(var(VAR_RESULT) == YES)
    {
        setflag(FLAG_ROGUE_UNLOCKED_PIKIN_EASTER_EGG)
        msgbox(format("{JPN}ポカビー: やあ {PLAYER}!\pそれは…\pやっぱり!\nぼくの メリープじゃないか!\pきみの ところに いったんだね?\pすくなくとも わくわくする ぼうけんを みせて あげられそうだ!"))

        poryswitch(ROGUE_VERSION)
        {
            ROGUE_VERSION_VANILLA
            {
                msgbox(format("{JPN}ピキンは ふぶきも おぼえられるって しってた?\pほら わざを おぼえる メニューから おしえられるように しておいたよ!\pピキンに わくわくする ぼうけんを みせて あげてね!"))
            }
            ROGUE_VERSION_EXPANSION
            {
                msgbox(format("{JPN}むかし ともだちの ために つくった\nむずかしい ハックでは ピキンに せんようの\lメガシンカを あげたんだ!\pメガメリープさ!\pあの ROMハックでは すこし やりすぎ だったけどね…\pああ わすれてた うっかり!\pエメラルドローグでも ピキンは\nメガシンカ できるんだよ!\pぼうふうを おぼえさせれば\nメガシンカ できるように なるんだ。\p… … …\pそう… レックウザと おなじさ…\pいいかい… ぼくは メリープが すきなんだ!\pほら!\pこれで わざおもいだしの メニューから\nピキンに ぼうふうを おぼえさせられるはず。\pぜひ メガメリープを ためして みてよ!\pただし しんかさせないように きをつけて\nさもないと また べつの ピキンを\lさがす はめに なるからね…\pまあ しょうじきに いうと…\nピキンは たくさん いるけどね…\pピキンに わくわくする ぼうけんを\nみせて あげて くれよ!"))
            }
        }
    }
    else
    {
        msgbox(format("{JPN}ポカビー: やあ {PLAYER}!\pエメラルドローグを たのしんでくれてると いいな!\pもし そうじゃないなら…\nどうしよう?\lごめん としか いえないな?"))
    }

    release
}

movement Rogue_Interior_ConfigLab_Pokabbie0
{
    face_left
    emote_exclamation_mark
    delay_16 * 4
    walk_left
}

movement Rogue_Interior_ConfigLab_Pokabbie1
{
    walk_fast_right
    face_up
}

movement Rogue_Interior_ConfigLab_Pokabbie2
{
    walk_fast_left
}

movement Pokabbie_Spin_FaceDown
{
    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1

    face_down
    delay_1
    
    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1

    face_down
    delay_1
}

movement Pokabbie_Spin_FaceLeft
{
    face_down
    delay_1
    
    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1

    face_down
    delay_1

    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1
}