const VAR_NODE_ID = VAR_0x8004
const VAR_NODE_PARAM0 = VAR_0x8005
const VAR_NODE_PARAM1 = VAR_0x8006

const VAR_LOAD_STATE = VAR_TEMP_0

mapscripts Rogue_AdventurePaths_MapScripts 
{
    MAP_SCRIPT_ON_RESUME: Rogue_AdventurePaths_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE 
    [
        VAR_LOAD_STATE, 0: Rogue_AdventurePaths_PreviewCutscene
    ]
}

script Rogue_AdventurePaths_OnLoad
{
    // If we want to do it, don't do it On load/Resume
    //special(SpawnCameraObject)
    //applymovement(OBJ_EVENT_ID_CAMERA, AdventurePaths_OffsetCamera)

    //special(RogueAdv_ApplyAdventureMetatiles)
}

script Rogue_AdventurePaths_PreviewCutscene
{
    setvar(VAR_LOAD_STATE, 1)
}

movement AdventurePaths_OffsetCamera {
    walk_right * 4
}

script Rogue_AdventurePaths_InteractRoom
{
    lock
    special(RogueAdv_GetLastInteractedRoomParams)

    switch(var(VAR_NODE_PARAM0))
    {
        case ADVPATH_ROOM_BOSS:
            msgbox(format("{JPN}さいきょうの トレーナーだ!"), MSGBOX_DEFAULT)
            setvar(VAR_RESULT, YES)

        case ADVPATH_ROOM_MINIBOSS:
            msgbox(format("{JPN}つよい トレーナーだ!\nここに はいりますか?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_WILD_DEN:
            msgbox(format("{JPN}{STR_VAR_1}タイプの ポケモンの すみかだ!\nここに はいりますか?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_HONEY_TREE:
            msgbox(format("{JPN}あまいミツの きの すみかだ!\nここに はいりますか?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_GAMESHOW:
            msgbox(format("{JPN}…ゲームショー?\nここに はいりますか?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_DARK_DEAL:
            msgbox(format("{JPN}あやしい とりひき…?\nここに はいりますか?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_LAB:
            msgbox(format("{JPN}ポケモンラボだ。\nここに はいりますか?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_SHRINE:
            msgbox(format("{JPN}ふしぎな ほこらだ。\nここに はいりますか?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_CATCHING_CONTEST:
            msgbox(format("{JPN}ポケモンとり コンテストだ。\nここに はいりますか?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_SIGN:
            msgbox(format("{JPN}ふしぎな かんばんだ。\nここに はいりますか?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_BATTLE_SIM:
            msgbox(format("{JPN}バトルシミュレーターだ。\nここに はいりますか?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_BATTLE_TOWER:
            msgbox(format("{JPN}バトルタワーだ。\nここに はいりますか?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_RESTSTOP:
            switch(var(VAR_NODE_PARAM1))
            {
                case ADVPATH_SUBROOM_RESTSTOP_FULL:
                    msgbox(format("{JPN}せつびの そろった きゅうけいじょだ。\nここに はいりますか?"), MSGBOX_YESNO)

                case ADVPATH_SUBROOM_RESTSTOP_SHOP:
                    msgbox(format("{JPN}ショップつきの きゅうけいじょだ。\nここに はいりますか?"), MSGBOX_YESNO)

                case ADVPATH_SUBROOM_RESTSTOP_BATTLE:
                    msgbox(format("{JPN}バトルじゅんびの きゅうけいじょだ。\nここに はいりますか?"), MSGBOX_YESNO)
                
                case ADVPATH_SUBROOM_RESTSTOP_DAYCARE:
                    msgbox(format("{JPN}そだてやの きゅうけいじょだ。\nここに はいりますか?"), MSGBOX_YESNO)

                default:
                    msgbox(format("{JPN}??\nここに はいりますか?"), MSGBOX_YESNO)
            }
            
        case ADVPATH_ROOM_ROUTE:
            switch(var(VAR_NODE_PARAM1))
            {
                case 0:
                    msgbox(format("{JPN}おだやかな {STR_VAR_1}の ルートだ。\nここに はいりますか?"), MSGBOX_YESNO)

                case 1:
                    msgbox(format("{JPN}ふつうの {STR_VAR_1}の ルートだ。\nここに はいりますか?"), MSGBOX_YESNO)

                case 2:
                    msgbox(format("{JPN}きびしい {STR_VAR_1}の ルートだ。\nここに はいりますか?"), MSGBOX_YESNO)

                default:
                    msgbox(format("{JPN}??\nここに はいりますか?"), MSGBOX_YESNO)
            }

        case ADVPATH_ROOM_LEGENDARY:
            msgbox(format("{JPN}でんせつの ポケモンだ!\nここに はいりますか?"), MSGBOX_YESNO)

        case ADVPATH_ROOM_TEAM_HIDEOUT:
            msgbox(format("{JPN}わるものの アジトだ!\nここに はいりますか?"), MSGBOX_YESNO)

        default:
            msgbox(format("{JPN}??\nここに はいりますか?"), MSGBOX_YESNO)
    }

    if(var(VAR_RESULT) == YES)
    {
        special(RogueAdv_WarpLastInteractedRoom)
    }

    release
}