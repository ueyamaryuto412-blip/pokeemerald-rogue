{
    clearflag(FLAG_HIDE_LILYCOVE_CONTEST_HALL_BLEND_MASTER)
    
    lock

    // MASTER_BERRY_COUNT
    msgbox(format("{JPN}こんにちは!\nわたしは {POKEBLOCK}づくりの めいじんです。\pきのみ 70こで {POKEBLOCK}を 30こまで つくれます。\pいっしょに {POKEBLOCK}を つくりますか?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        specialvar(VAR_RESULT, PlayerHasBerries)

        if(var(VAR_RESULT) == YES)
        {
            // MASTER_BERRY_COUNT
