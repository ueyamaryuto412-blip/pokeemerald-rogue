const VAR_ROGUE_INTRO_STATE = VAR_LITTLEROOT_INTRO_STATE
const VAR_PICKING_STARTER = VAR_TEMP_F

const NPC_BIRCH = 1

mapscripts Rogue_Hub_ProfLab_MapScripts 
{
    MAP_SCRIPT_ON_TRANSITION: Rogue_Hub_ProfLab_OnTransition
}

script Rogue_Hub_ProfLab_OnTransition
{
    switch(var(VAR_STARTER_MON))
    {
        case 1:
            setflag(FLAG_TEMP_1)
        case 2:
            setflag(FLAG_TEMP_2)
        case 3:
            setflag(FLAG_TEMP_3)
    }
}

script Rogue_Hub_ProfLab_SpeakProf
{
    lockall
    faceplayer

    if(flag(FLAG_ROGUE_RUN_ACTIVE))
    {
        msgbox(format("{JPN}オダマキ: やあ {PLAYER}!\nぼうけんを たのしめているかい!"))
        call(Rogue_Hub_ProfLab_ProfShowEvos)
    }
    else
    {
        if(var(VAR_ROGUE_INTRO_STATE) <= 3)
        {
            msgbox(format("{JPN}オダマキ: さあ!\nパートナーの ポケモンを えらんで!"), MSGBOX_DEFAULT)
        }
        else
        {
            call(Rogue_Hub_ProfLab_ProfExplain)
            if(var(VAR_RESULT) == NO)
            {
                call(Rogue_Hub_ProfLab_ProfShowEvos)
            }
        }
    }

    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("{JPN}オダマキ: わかった!\nせつめいが ひつようなら いつでも どうぞ。"), MSGBOX_DEFAULT)
    }

    releaseall
}

script Rogue_Hub_ProfLab_ProfExplain
{
    msgbox(format("{JPN}オダマキ: ぼうけんの しくみを せつめい しようか?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("{JPN}オダマキ: ぼうけんでは なにが\nおこるか わからない!\pルートは いれかわるし でてくる\nポケモンや トレーナーも かわる!\pぼうけんが おわると きょてんへ\nおくりとどけられて バッグと\lポケモンは もとの じょうたいに\lもどるんだ。\pだから ぼうけんちゅうに パートナーを\nしんかさせても きょてんに もどると\lしんかは とけてしまう。"), MSGBOX_DEFAULT)
        msgbox(format("{JPN}ぼうけんから もどると ほうしゅうが\nもらえて きょてんで じゆうに\lつかえる。\pきょてんで かったものや つかったものは\nずっと のこる。\pだから きょてんで キズぐすりを\nかいたして ぼうけんで つかっても\lもどれば バッグに もどっている。\pぼうけんを しるには なんども\nいってみるのが いちばん!\pさあ いってらっしゃい!\nたのしんできて!"), MSGBOX_DEFAULT)
    }

    return
}

script Rogue_Hub_ProfLab_ProfCycleEvos
{
    while(var(VAR_0x8005) < VAR_RESULT)
    {
        special(Rogue_GetMonEvoParams)
        addvar(VAR_0x8005, 1) // Increment now so text below doesn't count from 0

        buffernumberstring(STR_VAR_2, VAR_0x8005)

        switch(var(VAR_0x8006))
        {
            case EVO_FRIENDSHIP:
                msgbox(format("{JPN}{STR_VAR_2}。 なつきどを たかくする。"))

            case EVO_FRIENDSHIP_DAY:
                msgbox(format("{JPN}{STR_VAR_2}。 ひるに なつきどを たかくする。"))

            case EVO_FRIENDSHIP_NIGHT:
                msgbox(format("{JPN}{STR_VAR_2}。 よるに なつきどを たかくする。"))

            case EVO_LEVEL:
            case EVO_LEVEL_NINJASK:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox("{JPN}{STR_VAR_2}。 レベル{STR_VAR_3}まで あげる。")

            case EVO_TRADE:
                msgbox(format("{JPN}{STR_VAR_2}。 つうしんこうかんする。"))

            case EVO_TRADE_ITEM:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 {STR_VAR_3}を もたせて つうしんこうかんする。"))

            case EVO_ITEM:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 {STR_VAR_3}を つかう。"))

            case EVO_LEVEL_ATK_GT_DEF:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 こうげきが ぼうぎょより たかい じょうたいで レベル{STR_VAR_3}まで あげる。"))

            case EVO_LEVEL_ATK_EQ_DEF:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 こうげきと ぼうぎょが おなじ じょうたいで レベル{STR_VAR_3}まで あげる。"))

            case EVO_LEVEL_ATK_LT_DEF:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 こうげきが ぼうぎょより ひくい じょうたいで レベル{STR_VAR_3}まで あげる。"))

            case EVO_LEVEL_SILCOON:
            case EVO_LEVEL_CASCOON:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 とくていの せいかくで レベル{STR_VAR_3}まで あげる。"))

            case EVO_LEVEL_SHEDINJA:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 てもちに あきが ある じょうたいで レベル{STR_VAR_3}まで あげる。"))

            case EVO_BEAUTY:
                msgbox(format("{JPN}{STR_VAR_2}。 うつくしさを たかくする。"))

            case EVO_LEVEL_ITEM:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 {STR_VAR_3}を もたせて レベルアップさせる。"))


            // EX methods
            //
            case EVO_LEVEL_FEMALE:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 メスを レベル{STR_VAR_3}まで あげる。"))

            case EVO_LEVEL_MALE:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 オスを レベル{STR_VAR_3}まで あげる。"))

            case EVO_LEVEL_NIGHT:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 よるに レベル{STR_VAR_3}まで あげる。"))

            case EVO_LEVEL_DAY:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 ひるに レベル{STR_VAR_3}まで あげる。"))

            case EVO_LEVEL_DUSK:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 ゆうがたに レベル{STR_VAR_3}まで あげる。"))

            case EVO_ITEM_HOLD_DAY:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 ひるに {STR_VAR_3}を もたせて レベルアップさせる。"))

            case EVO_ITEM_HOLD_NIGHT:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 よるに {STR_VAR_3}を もたせて レベルアップさせる。"))
    

            case EVO_MOVE:
                buffermovename(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 {STR_VAR_3}を おぼえた じょうたいで レベルアップさせる。"))
    
            case EVO_MOVE_TYPE:
                msgbox(format("{JPN}{STR_VAR_2}。 フェアリータイプの わざを おぼえた じょうたいで レベルアップさせる。")) // Hard coded, as this is only instance

            case EVO_MAPSEC:
            case EVO_SPECIFIC_MAP:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 ???の ばしょで {STR_VAR_3}を もたせて レベルアップさせる。"))


            case EVO_ITEM_MALE:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 オスに {STR_VAR_3}を つかう。"))

            case EVO_ITEM_FEMALE:
                bufferitemname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 メスに {STR_VAR_3}を つかう。"))


            case EVO_LEVEL_RAIN:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 あめの ときに レベル{STR_VAR_3}まで あげる。"))

            case EVO_SPECIFIC_MON_IN_PARTY:
                bufferspeciesname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 てもちに {STR_VAR_3}が いる じょうたいで レベルアップさせる。"))

            case EVO_LEVEL_DARK_TYPE_MON_IN_PARTY:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 てもちに あくタイプが いる じょうたいで レベル{STR_VAR_3}まで あげる。"))

            case EVO_TRADE_SPECIFIC_MON:
                bufferspeciesname(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 {STR_VAR_3}と つうしんこうかんする。"))


            case EVO_LEVEL_NATURE_AMPED:
            case EVO_LEVEL_NATURE_LOW_KEY:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 とくていの せいかくで レベル{STR_VAR_3}まで あげる。"))

            case EVO_CRITICAL_HITS:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 1かいの バトルで きゅうしょに {STR_VAR_3}かい あてる。"))

            case EVO_SCRIPT_TRIGGER_DMG:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 HPが {STR_VAR_3}より すくない ときに ???を しらべる。"))
    
            case EVO_DARK_SCROLL:
            case EVO_WATER_SCROLL:
                msgbox(format("{JPN}{STR_VAR_2}。 ???を しらべる。"))

            default:
                buffernumberstring(STR_VAR_3, VAR_0x8007)
                msgbox(format("{JPN}{STR_VAR_2}。 ふめいな しんかじょうけん、{STR_VAR_3}。"))
        }
    }
}

script Rogue_Hub_ProfLab_ProfShowEvos
{
    msgbox(format("{JPN}オダマキ: ポケモンの しんかを しらべるかい?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("{JPN}どのポケモンを しらべますか?"))
        special(ChoosePartyMon)
        waitstate
        
        if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
        {
            msgbox(format("{JPN}オダマキ: わかった!\nこまったら いつでも たずねて。"), MSGBOX_DEFAULT)
        }
        else
        {
            specialvar(VAR_RESULT, Rogue_GetMonEvoCount)
            special(BufferMonNickname)

            if(var(VAR_RESULT) == 0)
            {
                msgbox(format("{JPN}{STR_VAR_1}は いま しんかさきが ないようだ。"))
            }
            elif(var(VAR_RESULT) == 1)
            {
                buffernumberstring(STR_VAR_2, VAR_RESULT)
                msgbox(format("{JPN}{STR_VAR_1}には いま {STR_VAR_2}つの しんかさきが ある。"))

                setvar(VAR_0x8005, 0)
                call(Rogue_Hub_ProfLab_ProfCycleEvos)
                msgbox(format("{JPN}オダマキ: また こまったら いつでも たずねて。"), MSGBOX_DEFAULT)
            }
            else
            {
                buffernumberstring(STR_VAR_2, VAR_RESULT)
                msgbox(format("{JPN}{STR_VAR_1}には いま {STR_VAR_2}つの しんかさきが ある。"))

                setvar(VAR_0x8005, 0)
                call(Rogue_Hub_ProfLab_ProfCycleEvos)
                msgbox(format("{JPN}オダマキ: また こまったら いつでも たずねて。"), MSGBOX_DEFAULT)
            }
        }

        setvar(VAR_RESULT, YES)
    }
}

script Rogue_Hub_ProfLab_TriggerPC
{
    lockall
    msgbox(format("{JPN}「いまは つかわない ほうが いいな」"), MSGBOX_DEFAULT)
    applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkBackwards)
    waitmovement(0)
    releaseall
}

movement Rogue_Hub_ProfLab_WalkBackwards 
{
    walk_down
}

script Rogue_Hub_ProfLab_IntroCommon
{
    msgbox(format("{JPN}オダマキ: {PLAYER}!\nやっと きたね!\pぼうけんに でたくて うずうず\nしてるだろうけど そのまえに\lじぶんの ポケモンが ひつようだ。"), MSGBOX_DEFAULT)
    turnobject(NPC_BIRCH, DIR_EAST)
    msgbox(format("{JPN}オダマキ: けさ きみのために\nなんびきか つかまえてきたよ。\pすきなのを えらんで!"), MSGBOX_DEFAULT)
    return
}

script Rogue_Hub_ProfLab_IntroRunAwayCommon
{
    bufferspeciesname(STR_VAR_1, SPECIES_SUNKERN)
    givemon(SPECIES_SUNKERN, 7, ITEM_ORAN_BERRY)

    playfanfare(MUS_OBTAIN_ITEM)
    message(format("{PLAYER} obtained a {STR_VAR_1}."))
    waitmessage
    waitfanfare

    msgbox(format("{JPN}オダマキ: {STR_VAR_1}に ニックネームを つけるかい?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES)
    {
        call(Common_EventScript_NameReceivedPartyMon)
    }
    
    setvar(VAR_STARTER_MON, 4)

    call(Rogue_Hub_ProfLab_PostStarterSelect)
    return
}

script Rogue_Hub_ProfLab_IntroTriggerL
{
    lockall
    if(var(VAR_PICKING_STARTER) != YES)
    {
        setvar(VAR_PICKING_STARTER, YES)

        applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkToProfL)
        waitmovement(0)

        call(Rogue_Hub_ProfLab_IntroCommon)
    }
    else
    {
        turnobject(NPC_BIRCH, DIR_SOUTH)
        turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)

        msgbox(format("{JPN}オダマキ: おや…\pちがう ポケモンの ほうが いいかな?"), MSGBOX_YESNO)

        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("{JPN}オダマキ: はい どうぞ!"), MSGBOX_DEFAULT)

            applymovement(NPC_BIRCH, Rogue_Hub_ProfLab_WalkFromProfL)
            waitmovement(0)

            call(Rogue_Hub_ProfLab_IntroRunAwayCommon)
        }
        else
        {
            applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkUpOne)
            waitmovement(0)
        }
    }
    releaseall
}

script Rogue_Hub_ProfLab_IntroTriggerR
{
    lockall
    if(var(VAR_PICKING_STARTER) != YES)
    {
        setvar(VAR_PICKING_STARTER, YES)

        applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkToProfR)
        waitmovement(0)

        call(Rogue_Hub_ProfLab_IntroCommon)
    }
    else
    {
        turnobject(NPC_BIRCH, DIR_SOUTH)
        turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)

        msgbox(format("{JPN}オダマキ: おや…\pちがう ポケモンが いいかい?"), MSGBOX_YESNO)

        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("{JPN}オダマキ: はい どうぞ!"), MSGBOX_DEFAULT)

            applymovement(NPC_BIRCH, Rogue_Hub_ProfLab_WalkFromProfR)
            waitmovement(0)

            call(Rogue_Hub_ProfLab_IntroRunAwayCommon)
        }
        else
        {
            applymovement(OBJ_EVENT_ID_PLAYER, Rogue_Hub_ProfLab_WalkUpOne)
            waitmovement(0)
        }
    }
    releaseall
}

movement Rogue_Hub_ProfLab_WalkUpOne
{
    walk_up
}

movement Rogue_Hub_ProfLab_WalkToProfL
{
    walk_up * 3
}

movement Rogue_Hub_ProfLab_WalkToProfR
{
    walk_left
    walk_up * 3
}

movement Rogue_Hub_ProfLab_WalkFromProfL
{
    walk_down * 3
}

movement Rogue_Hub_ProfLab_WalkFromProfR
{
    walk_right
    walk_down * 3
}

script Rogue_Hub_ProfLab_PokeballCommon
{
    if(var(VAR_ROGUE_INTRO_STATE) <= 3)
    {
        turnobject(NPC_BIRCH, DIR_EAST)

        showmonpic(VAR_0x8001, 10, 3)
        playmoncry(VAR_0x8001, CRY_MODE_NORMAL)
        waitmoncry

        bufferspeciesname(STR_VAR_1, VAR_0x8001)
        msgbox(format("BIRCH: You'd like to take {STR_VAR_1}?"), MSGBOX_YESNO)
        hidemonpic

        if(var(VAR_RESULT) == YES)
        {
            removeobject(VAR_LAST_TALKED)
            givemon(VAR_0x8001, 7, ITEM_ORAN_BERRY)

            playfanfare(MUS_OBTAIN_ITEM)
            message(format("{PLAYER} obtained a {STR_VAR_1}."))
            waitmessage
            waitfanfare

            msgbox(format("{JPN}オダマキ: {STR_VAR_1}に ニックネームを つけるかい?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES)
            {
                call(Common_EventScript_GetGiftMonPartySlot)
                call(Common_EventScript_NameReceivedPartyMon)
            }
            
            turnobject(OBJ_EVENT_ID_PLAYER, DIR_WEST)
            call(Rogue_Hub_ProfLab_PostStarterSelect)

            setvar(VAR_RESULT, YES)
            return
        }
    }
    else
    {
        bufferspeciesname(STR_VAR_1, VAR_0x8001)
        msgbox(format("{JPN}「かわいそうな {STR_VAR_1}…」\p「さびしいだろうな…」"))
    }

    setvar(VAR_RESULT, NO)
    return
}

script Rogue_Hub_ProfLab_PostStarterSelect
{
    msgbox(format("{JPN}オダマキ: どうぐと ポケモンずかんも いれておいたよ!"), MSGBOX_DEFAULT)
    
    giveitem(ITEM_POKE_BALL, 5)
    giveitem(ITEM_POTION, 1)
    
    setflag(FLAG_SYS_POKEDEX_GET)
    setflag(FLAG_SYS_POKEMON_GET)
    setvar(VAR_ROGUE_INTRO_STATE, 4)

    msgbox(format("{JPN}これで ぼうけんに でる じゅんびが できた!"), MSGBOX_DEFAULT)

    call(Rogue_Hub_ProfLab_ProfExplain)

    special(Rogue_SetupFollowParterMonObjectEvent)
    return
}

script Rogue_Hub_ProfLab_Pokeball0
{
    lock
    copyvar(VAR_0x8001, VAR_ROGUE_STARTER0)
    call(Rogue_Hub_ProfLab_PokeballCommon)

    if(var(VAR_RESULT) == YES)
    {
        setvar(VAR_STARTER_MON, 1)
        setflag(FLAG_TEMP_1)
    }

    release
}

script Rogue_Hub_ProfLab_Pokeball1
{
    lock
    copyvar(VAR_0x8001, VAR_ROGUE_STARTER1)
    call(Rogue_Hub_ProfLab_PokeballCommon)

    if(var(VAR_RESULT) == YES)
    {
        setvar(VAR_STARTER_MON, 2)
        setflag(FLAG_TEMP_2)
    }

    release
}

script Rogue_Hub_ProfLab_Pokeball2
{
    lock
    copyvar(VAR_0x8001, VAR_ROGUE_STARTER2)
    call(Rogue_Hub_ProfLab_PokeballCommon)

    if(var(VAR_RESULT) == YES)
    {
        setvar(VAR_STARTER_MON, 3)
        setflag(FLAG_TEMP_3)
    }

    release
}