const VAR_BERRY_BUFF_AMOUNT = VAR_0x8005

const BERRY_BUFF_FRIEND = 0
const BERRY_BUFF_HP = 1
const BERRY_BUFF_ATK = 2
const BERRY_BUFF_DEF = 3
const BERRY_BUFF_SPD = 4
const BERRY_BUFF_SPATK = 5
const BERRY_BUFF_SPDEF = 6
const BERRY_BUFF_WEAKEN = 7

mapscripts Rogue_Hub_Bakery_MapScripts {}



script RogueHub_Bakery_SpeakChef_ApplyTreat
{
    special(Rogue_ApplyBerryTreat)

    if(var(VAR_RESULT) == YES)
    {
        playse(SE_SHOP)
        waitse

        updatemoneybox

        msgbox(format("{JPN}すぐに おつくりします!"))

        fadescreen(FADE_TO_BLACK)
        playfanfare(MUS_HEAL)
        waitfanfare
        fadescreen(FADE_FROM_BLACK)

        special(BufferMonNickname)
        special(Rogue_CheckBerryTreat)
        switch(var(VAR_RESULT))
        {
            case BERRY_BUFF_FRIEND:
                msgbox(format("{JPN}{STR_VAR_1}は なついた みたいだ。"))

            case BERRY_BUFF_HP:
                msgbox(format("{JPN}{STR_VAR_1}の HPが のびた。"))

            case BERRY_BUFF_ATK:
                msgbox(format("{JPN}{STR_VAR_1}の こうげきが のびた。"))

            case BERRY_BUFF_DEF:
                msgbox(format("{JPN}{STR_VAR_1}の ぼうぎょが のびた。"))

            case BERRY_BUFF_SPATK:
                msgbox(format("{JPN}{STR_VAR_1}の とくこうが のびた。"))

            case BERRY_BUFF_SPDEF:
                msgbox(format("{JPN}{STR_VAR_1}の とくぼうが のびた。"))

            case BERRY_BUFF_SPD:
                msgbox(format("{JPN}{STR_VAR_1}の すばやさが のびた。"))

            case BERRY_BUFF_WEAKEN:
                msgbox(format("{JPN}{STR_VAR_1}は よわく なった。"))
        }

        msgbox(format("{JPN}あなたと {STR_VAR_1}に\nよろこんで もらえたなら うれしいです!\pまた どうぞ!"))
        setvar(VAR_RESULT, YES)
    }
    else
    {
        special(BufferMonNickname)
        msgbox(format("{JPN}あら。\p{STR_VAR_1}は おなかが いっぱいで たべられない みたいです。"))
    }
}

script RogueHub_Bakery_SpeakChefSlice
{
    lock
    faceplayer

    setvar(VAR_0x8004, 0)
    special(BufferMonNickname)

    msgbox(format("{JPN}パンやへ ようこそ!\nカップケーキが とくいで\lポケモンの のうりょくを\lすこし あげられます。\pあなたと {STR_VAR_1}で わけられる\nカップケーキを やきましょうか?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("{JPN}どの きのみを つかいますか?"))

        fadescreen(FADE_TO_BLACK)
        special(Bag_ChooseBerry)
        waitstate

        if(var(VAR_ITEM_ID) == 0)
        {
            setvar(VAR_RESULT, NO)
        }
        else
        {
            showmoneybox(0, 0)

            msgbox(format("{JPN}それには きのみが 3つ ひつようです。\pそれと 500¥ いただきます。"))

            checkitem(VAR_ITEM_ID, 3)
            if(var(VAR_RESULT) == NO)
            {
                msgbox(format("{JPN}あら。\nきのみが たりないようです。"))
            }
            else
            {
                checkmoney(500)
                if(var(VAR_RESULT) == NO)
                {
                    msgbox(format("{JPN}あら。\nおかねが たりないようです。"))
                }
            }

            if(var(VAR_RESULT) == YES)
            {
                msgbox(format("{JPN}それでは おあずかりして やきはじめても よろしいですか?"), MSGBOX_YESNO)
            }

            if(var(VAR_RESULT) == YES)
            {
                setvar(VAR_BERRY_BUFF_AMOUNT, 1)
                call(RogueHub_Bakery_SpeakChef_ApplyTreat)
                if(var(VAR_RESULT) == YES)
                {
                    removemoney(500)
                    removeitem(VAR_ITEM_ID, 3)
                }
            }

            closemessage
            hidemoneybox
        }
    }
    
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("{JPN}きが かわったら いつでも どうぞ。"))
    }

    release
}

script RogueHub_Bakery_SpeakChefFull
{
    lock
    faceplayer

    setvar(VAR_0x8004, 0)
    special(BufferMonNickname)

    msgbox(format("{JPN}パンやへ ようこそ! パイが とくいで ポケモンの\nのうりょくを あげられます。\pあなたと {STR_VAR_1}で わけられる パイを やきましょうか?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("{JPN}どの きのみを つかいますか?"))

        fadescreen(FADE_TO_BLACK)
        special(Bag_ChooseBerry)
        waitstate

        if(var(VAR_ITEM_ID) == 0)
        {
            setvar(VAR_RESULT, NO)
        }
        else
        {
            showmoneybox(0, 0)

            msgbox(format("{JPN}それには きのみが 15こ ひつようです。\pそれと 2500¥ いただきます。"))

            checkitem(VAR_ITEM_ID, 15)
            if(var(VAR_RESULT) == NO)
            {
                msgbox(format("{JPN}あら。\nきのみが たりないようです。"))
            }
            else
            {
                checkmoney(2500)
                if(var(VAR_RESULT) == NO)
                {
                    msgbox(format("{JPN}あら。\nおかねが たりないようです。"))
                }
            }

            if(var(VAR_RESULT) == YES)
            {
                msgbox(format("{JPN}それでは おあずかりして やきはじめても よろしいですか?"), MSGBOX_YESNO)
            }

            if(var(VAR_RESULT) == YES)
            {
                setvar(VAR_BERRY_BUFF_AMOUNT, 5)
                call(RogueHub_Bakery_SpeakChef_ApplyTreat)
                if(var(VAR_RESULT) == YES)
                {
                    removemoney(2500)
                    removeitem(VAR_ITEM_ID, 15)
                }
            }

            closemessage
            hidemoneybox
        }
    }
    
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("{JPN}きが かわったら いつでも どうぞ。"))
    }

    release
}

script RogueHub_Bakery_SpeakBerryCheck
{
    lock
    faceplayer

    msgbox(format("{JPN}きのみの しゅるいで やいたあとに あがる のうりょくが かわるのを ごぞんじですか。"))
    msgbox(format("{JPN}どの きのみが どの のうりょくを あげるか おしえましょうか?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        fadescreen(FADE_TO_BLACK)
        special(Bag_ChooseBerry)
        waitstate

        if(var(VAR_ITEM_ID) != 0)
        {
            special(Rogue_CheckBerryTreat)
            bufferitemname(STR_VAR_1, VAR_ITEM_ID)
            switch(var(VAR_RESULT))
            {
                case BERRY_BUFF_FRIEND:
                    msgbox(format("{JPN}{STR_VAR_1}は ポケモンを なつかせます。"))

                case BERRY_BUFF_HP:
                    msgbox(format("{JPN}{STR_VAR_1}は ポケモンの HPを のばします。"))

                case BERRY_BUFF_ATK:
                    msgbox(format("{JPN}{STR_VAR_1}は ポケモンの こうげきを のばします。"))

                case BERRY_BUFF_DEF:
                    msgbox(format("{JPN}{STR_VAR_1}は ポケモンの ぼうぎょを のばします。"))

                case BERRY_BUFF_SPATK:
                    msgbox(format("{JPN}{STR_VAR_1}は ポケモンの とくこうを のばします。"))

                case BERRY_BUFF_SPDEF:
                    msgbox(format("{JPN}{STR_VAR_1}は ポケモンの とくぼうを のばします。"))

                case BERRY_BUFF_SPD:
                    msgbox(format("{JPN}{STR_VAR_1}は ポケモンの すばやさを のばします。"))

                case BERRY_BUFF_WEAKEN:
                    msgbox(format("{JPN}{STR_VAR_1}は ポケモンを よわく します。"))
            }
        }
    }

    release
}

script RogueHub_Bakery_SpeakIVEVInspector
{
    lock
    faceplayer

    msgbox(format("{JPN}ポケモンの つよさをみる がめんで\nAボタンを おすと こたいちと\lどりょくちを みられるのを\lごぞんじですか?\pさいきんの ぎじゅつは すごいですね!"))

    release
}

