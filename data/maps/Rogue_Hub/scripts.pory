script RogueHub_HintRouteAdjectives
{
    lock
    faceplayer

    msgbox(format("{JPN}じかんは かかったが やっと ルートの なまえの いみが わかった!"), MSGBOX_DEFAULT)
    msgbox(format("{JPN}おしえようか?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("{JPN}ルートの なまえは 2つの ことばから できている。\pなんいどと タイプの ヒントだ。"), MSGBOX_DEFAULT)
        msgbox(format("{JPN}なんいどは 3つ。\nおだやか ふつう きびしい。\pおだやかな ルートは やせいポケモンが おおく どうぐは すくなめで トレーナーも よわい。\pきびしい ルートは やせいポケモンが すくなく どうぐは おおく トレーナーも つよい。\pふつうは その ちゅうかんだ。"), MSGBOX_DEFAULT)
        msgbox(format("{JPN}2つめの ことばは タイプの ヒントで どんな タイプの やせいポケモンが でそうかが わかる。\pたとえば あたたかい ルートには ほのおタイプが でる かのうせいが ある。\pかならず その タイプが いる わけでは ない。\pほかの ルートより でやすい だけだ。"), MSGBOX_DEFAULT)
    }

    release
}


