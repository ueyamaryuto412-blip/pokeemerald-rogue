mapscripts Rogue_Interior_School_MapScripts {}


script Rogue_Interior_School_ShowSetRecommendation
{
    lock
    faceplayer
    
    msgbox(format("{JPN}おや きみは トレーナーだね。\pぼくだったら ポケモンを どう そだてるか\nアドバイスして あげよう。"))

    setvar(VAR_0x8004, 0)

    while(var(VAR_0x8004) != PARTY_SIZE)
    {
        specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
        showplayerpartypic(VAR_0x8004, 2, 2)
        playmoncry(VAR_RESULT, CRY_MODE_NORMAL)

        callnative(ScriptMenu_DisplayRecommendedMonSet)
        messageinstant("{JPN}{DPAD_LEFTRIGHT} てもちを きりかえる\n{A_BUTTON} {B_BUTTON} おわる")
        waitstate
        hidemonpic
    }

    msgbox(format("{JPN}こまったことが あったら いつでも きいてね!"))

    release
}

script Rogue_Interior_School_TalkRunningKid0
{
    lockall
    faceplayer

    msgbox(format("{JPN}Bを 2かい おして すごく はやく はしってる!\pやせいの ポケモンから はやく にげたい ときも おなじ!\pはやい!"))

    releaseall
}

script Rogue_Interior_School_TalkRunningKid1
{
    lockall
    faceplayer

    msgbox(format("{JPN}もどってこい!\nB B B B B B!"))

    releaseall
}

script Rogue_Interior_School_TalkRunningStatsHint
{
    lockall
    faceplayer

    msgbox(format("{JPN}うああ!\pおもいどおりの どりょくちを\nつけるのが むずかしくなったよ!\pまえは やせいの ポケモンと\nたたかって かせいだ ものだけど\pいまは トレーナーとの しょうぶで\nどりょくちが はいるんだ。\pしかも どんな どりょくちが つくかは\nせいかくで きまるんだよ。\pだから いい せいかくを はやめに\nてに いれるのが とても だいじ!\pでも どりょくちも こたいちも\nいつでも かくにんできるよ!\pポケモンの のうりょくがめんで\n{A_BUTTON} を おせば みられるんだ。"))

    releaseall
}

script Rogue_Interior_School_TalkPokeblock
{
    lockall
    faceplayer

    msgbox(format("{JPN}ぼくの ポケモンは {POKEBLOCK}が だいすき!\pしってるかい? ルートに いるときは\n{POKEBLOCK}を まくことが できるんだ。\pすると あたらしい タイプの ポケモンが\nよって くるかも しれないよ。"))

    releaseall
}

script Rogue_Interior_School_TalkTeacher
{
    lockall
    faceplayer

    msgbox(format("{JPN}ああ! ようこそ!\pせいとたちには ぼうけんのことを\nできる かぎり おしえて きたよ。\pていねいに たずねれば きっと\nよろこんで おしえて くれるはずさ!"))

    releaseall
}

script Rogue_Interior_School_TalkRouteHint
{
    lockall
    faceplayer


    msgbox(format("{JPN}ぼくは いろんな しゅるいの\nであいに ついて けんきゅうちゅう!\pまだまだ わからないことも おおいけど\pいままで わかったことなら\nおしえて あげられるよ!"))

    setvar(VAR_RESULT, 0)

    while(var(VAR_RESULT) != MULTI_B_PRESSED)
    {
        begindynamicmultichoice
        appenddynamicmultichoice("{JPN}ルートの なんいど", 0)
        appenddynamicmultichoice("{JPN}ルートの タイプ", 1)
        appenddynamicmultichoice("{JPN}そだった ポケモンの すみか", 2)
        appenddynamicmultichoice("{JPN}ハニーツリー", 3)

        message(format("{JPN}なにか ききたいことは あるかい?"))
        waitmessage
        enddynamicmultichoice(20, 2, 5, TRUE)
        
        switch(var(VAR_RESULT))
        {
            case 0:
                msgbox(format("{JPN}それでは!\nルートには つねに 2つの ヒントが つくんだ。\pひとつめは なんいど。\nふたつめは タイプだよ。\pなんいどは 3しゅるい。\nおだやか ふつう きびしい だ。\pおだやかな ルートでは やせいの ポケモンが\nおおく どうぐや トレーナーは すくない。\pきびしい ルートでは やせいの ポケモンが\nすくなく どうぐや トレーナーが おおい。\pそういう ルートで みつかる どうぐは\nねうちの あるものが おおいんだ。\pそのかわり そこを あるく トレーナーも\nずっと つよい けいこうに あるよ!\pふつうの なんいどは\nその 2つの ちょうどまんなか。\pあたらしい ポケモンを どうしても\nつかまえたいので なければ ぶなんな せんたくさ!"))

            case 1:
                msgbox(format("{JPN}それでは!\nルートには つねに 2つの ヒントが つくんだ。\pひとつめは なんいど。\nふたつめは タイプだよ。\pタイプの ヒントは かんたん。\nそれぞれが ポケモンの タイプを さしている。\pたとえば あたたかいは ほのおタイプ\nふしぎなは エスパータイプ という ぐあいさ。\pタイプの ヒントが あるということは\nその タイプの ポケモンが すくなくとも\n1ぴきは あらわれる ということだよ。\pおだやかな ルートなら ヒントに あう\nポケモンが 2ひき いじょう いることも おおいね。"))

            case 2:
                msgbox(format("{JPN}それでは!\nこの であいに でてくる ポケモンは とても かわった やつらでね!\pまるで すでに しょうぶの ために\nそだてられて いるかの ようなんだ!\pせいかくも とくせいも わざも たいてい よくて\nこたいちが ひとつは かんぺきなことも おおい!\pとても つよいから ひとりで くらすのを\nこのむし はいるまで なにが いるか わからない。\pリザードンかも しれないし\nコイキングかも しれない…\pだから ときには かけに なるんだよ。"))

            case 3:
                msgbox(format("{JPN}それでは!\nハニーツリーが やくにたつのは {POKEBLOCK}を もっている ときだけさ。\pやせいの ポケモンが たべたり くつろいだり\nしにくる ばしょだから いつでも てきとうな\nポケモンが ちかくに いるものだけど\nそばで {POKEBLOCK}を まくと\nほんとうに やくにたつんだ!\pつぎに ハニーツリーを おとずれた ときには\nまいた {POKEBLOCK}を たべている ポケモンが\nほぼ かならず みつかるよ。\pたとえば フシギダネが ほしいなら\nくさと どくの {POKEBLOCK}を まいておけば\nつぎに きたとき フシギダネが いるかも!\pもちろん ナゾノクサかも しれないし\nマダツボミかも しれないけどね…\pどれだけ うまくいくかは その ポケモンの\nタイプの くみあわせが めずらしいかどうか\nそして あう {POKEBLOCK}を もっているか しだいさ。"))

            case MULTI_B_PRESSED:
                msgbox(format("{JPN}ああ そうかい…\nききたく なったら まだまだ はなせるよ!"))
        }
    }

    releaseall
}