script Rogue_Area_RideTraining_GiveGoldWhistle
{
    showmoneybox(0, 0)

    msgbox(format("{JPN}きんの ふえを 15000¥で ゆずろうか?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        checkconstantmoney(15000)
        if(var(VAR_RESULT) == YES)
        {
            removeconstantmoney(15000)
            updatemoneybox

            playse(SE_SHOP)
            waitse

            msgbox(format("{JPN}ありがとう {PLAYER}!"))
            msgbox(format("{JPN}はい どうぞ!"))

            hidemoneybox
            giveitem(ITEM_GOLD_RIDING_WHISTLE)

            msgbox(format("{JPN}その きんの ふえは てもちの\nポケモンでは なく ぼくの\lともだちと つながっているんだ。\pさあ でておいで!"))

            poryswitch(ROGUE_VERSION)
            {
                ROGUE_VERSION_VANILLA
                {
                    clearflag(FLAG_HIDE_DITTO)
                    addobject(NPC_OBJ_DITTO)
                    playmoncry(SPECIES_DITTO, CRY_MODE_NORMAL)
                    waitmoncry

                    msgbox(format("{JPN}いつでも メタモンに はなしかけて\nてもちの ポケモンに へんしんさせられる。\pそうすれば その ポケモンが\nてもちに いなくても きんの ふえで\lよびだせるように なるんだ。"))

                    message(format("{JPN}{COLOR GREEN}{SHADOW LIGHT_GREEN}{PLAYER}は メタモンの よびかたを おぼえた!"))
                    waitmessage
                    playfanfare(MUS_EVOLVED)
                    waitfanfare
                }
                ROGUE_VERSION_EXPANSION
                {
                    clearflag(FLAG_HIDE_DITTO)
                    addobject(NPC_OBJ_DITTO)
                    playmoncry(SPECIES_ZORUA_HISUIAN, CRY_MODE_NORMAL)
                    waitmoncry

                    msgbox(format("{JPN}いつでも ゾロアに はなしかけて\nてもちの ポケモンに へんしんさせられる。\pそうすれば その ポケモンが\nてもちに いなくても きんの ふえで\lよびだせるように なるんだ。"))

                    message(format("{JPN}{COLOR GREEN}{SHADOW LIGHT_GREEN}{PLAYER}は ゾロアの よびかたを おぼえた!"))
                    waitmessage
                    playfanfare(MUS_EVOLVED)
                    waitfanfare
                }
            }
        }
        else
        {
            msgbox(format("{JPN}おや… いまは おかねが たりないようだね。"))
            hidemoneybox
        }
    }
    else
    {
        hidemoneybox
    }
}

