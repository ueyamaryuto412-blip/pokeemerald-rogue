script Rogue_Area_RideTraining_TeachFly
{
    showmoneybox(0, 0)

    msgbox(format("{JPN}そらの とびかたを 30000¥で おしえようか?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
