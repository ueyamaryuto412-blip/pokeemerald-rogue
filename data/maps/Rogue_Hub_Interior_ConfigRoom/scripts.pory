const OBJ_ASSISTANT_ID =  1
const OBJ_POKABBIE_ID =  4

const VAR_FLAG_STATE = VAR_0x8000
const FLAG_SEED_APPLY_MOVEMENT = FLAG_TEMP_2

// Temp hack to get compile until this map is deleted
const FLAG_ROGUE_EXP_ALL = FLAG_TEMP_1
const FLAG_ROGUE_CAN_OVERLVL = FLAG_TEMP_1
const FLAG_ROGUE_EV_GAIN_ENABLED = FLAG_TEMP_1
const FLAG_ROGUE_OVERWORLD_WILD_MONS = FLAG_TEMP_1
const FLAG_ROGUE_FORCE_BASIC_BAG = FLAG_TEMP_1

const FLAG_ROGUE_HARD_TRAINERS = FLAG_TEMP_1
const FLAG_ROGUE_EASY_TRAINERS = FLAG_TEMP_2
const FLAG_ROGUE_HARD_LEGENDARIES = FLAG_TEMP_1
const FLAG_ROGUE_EASY_LEGENDARIES = FLAG_TEMP_2

const FLAG_ROGUE_HOENN_ROUTES = FLAG_TEMP_2
const FLAG_ROGUE_HOENN_BOSSES = FLAG_TEMP_2
const FLAG_ROGUE_KANTO_ROUTES = FLAG_TEMP_2
const FLAG_ROGUE_KANTO_BOSSES = FLAG_TEMP_2
const FLAG_ROGUE_JOHTO_ROUTES = FLAG_TEMP_2
const FLAG_ROGUE_JOHTO_BOSSES = FLAG_TEMP_2

const METATILE_BikeShop_Button_Red = 0x23E

mapscripts Rogue_Hub_Interior_ConfigRoom_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_ConfigRoom_OnLoad
}

script Rogue_ConfigRoom_OnLoad
{
    setvar(VAR_FOLLOW_MON_0, SPECIES_DITTO)
    call(Rogue_ConfigRoom_RedrawMap)
}

script Rogue_ConfigRoom_TalkLanette
{
    lock
    faceplayer
    msgbox(format("{JPN}ラネット: やあ {PLAYER}!\pここは せっていラボ!\pつぎの ぼうけんの せっていを\nここで かえられるよ。\pスイッチの うえに のれば\nせっていを かえられる。"), MSGBOX_DEFAULT)
    release
}

script Rogue_ConfigRoom_TalkAssistant
{
    lock
    faceplayer
    if(flag(FLAG_SET_SEED_ENABLED) == FALSE)
    {
        msgbox(format("{JPN}アシスタント: こちらの せっていは\nシードモードのものです!\pシードモードでは いつも おなじ ルート\lトレーナー ポケモンが でてきます。\pつぎの ぼうけんで シードモードを\nつかいますか?"), MSGBOX_DEFAULT)
    }

    clearflag(FLAG_SEED_APPLY_MOVEMENT)
    call(Rogue_ConfigRoom_TalkAssistantInternal)
    release
}

script Rogue_ConfigRoom_SpeakSeedMode
{
    lock
    faceplayer
    if(flag(FLAG_SET_SEED_ENABLED) == FALSE)
    {
        msgbox(format("{JPN}アシスタント: つぎの ぼうけんで\nシードモードを つかいますか?"), MSGBOX_DEFAULT)
    }

    clearflag(FLAG_SEED_APPLY_MOVEMENT)
    call(Rogue_ConfigRoom_TalkAssistantInternal)
    release
}

script Rogue_ConfigRoom_TalkAssistantInternal
{
    if(flag(FLAG_SET_SEED_ENABLED) == TRUE)
    {
        msgbox(format("{JPN}アシスタント: シードモードを\nやめますか?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("{JPN}アシスタント: わかりました。\nシードモードを やめます"), MSGBOX_DEFAULT)
            clearflag(FLAG_SET_SEED_ENABLED)

            if(flag(FLAG_SEED_APPLY_MOVEMENT))
            {
                applymovement(OBJ_EVENT_ID_PLAYER, ConfigRoom_WalkLeft)
                applymovement(OBJ_ASSISTANT_ID, ConfigRoom_LookLeft)
                waitmovement(0)
            }
        }
    }
    else
    {
        msgbox(format("{JPN}アシスタント: つぎの ぼうけんで\nシードモードを つかいますか?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("{JPN}アシスタント: シードの ことばを\nえらんでください"), MSGBOX_DEFAULT)
            setvar(VAR_0x8004, EASY_CHAT_TYPE_ROGUE_SEED)
            call(Common_ShowEasyChatScreen)

            if(var(VAR_RESULT) == TRUE)
            {
                msgbox(format("{JPN}アシスタント: わかりました。\nそのことばで シードモードに します!"), MSGBOX_DEFAULT)
                setflag(FLAG_SET_SEED_ENABLED)
            }
            else
            {
                msgbox(format("{JPN}アシスタント: そうですか。\nシードモードを つかいたく なったら\lこえを かけてください"), MSGBOX_DEFAULT)
                if(flag(FLAG_SEED_APPLY_MOVEMENT))
                {
                    applymovement(OBJ_EVENT_ID_PLAYER, ConfigRoom_WalkLeft)
                    applymovement(OBJ_ASSISTANT_ID, ConfigRoom_LookLeft)
                    waitmovement(0)
                }
            }
        }
        else
        {
            if(flag(FLAG_SEED_APPLY_MOVEMENT))
            {
                applymovement(OBJ_EVENT_ID_PLAYER, ConfigRoom_WalkLeft)
                applymovement(OBJ_ASSISTANT_ID, ConfigRoom_LookLeft)
                waitmovement(0)
            }
        }
    }
}

script Rogue_ConfigRoom_Campaign_CampaignDescription
{
    switch(var(VAR_ROGUE_DESIRED_CAMPAIGN))
    {
        case ROGUE_CAMPAIGN_LOW_BST:
            msgbox(format("{JPN}BSTカップは しゅぞくちごうけいカップの りゃくだ。\pできるだけ よわい ポケモン つまり しゅぞくちごうけいの ひくい ポケモンで クリアを めざす。\pてもちの ポケモン すべてが スコアの たいしょうに なる。\pこの キャンペーンでは ふつうの ぼうけんに でる ひつようが ある。\pガントレットと レインボーは だめだ!\pさらに せっていラボの せっていが かわり わざマシンの どくどくは きんしに なる。\p「スコアは バトルの はじめに こうしんされる。つかまえたり にがしたり する よゆうを もたせる ためだ」"))
            msgbox(format("{JPN}キャンペーンちゅうかどうかは ぼうけんの はじめに しらせが でるし メニューで いまの スコアも みられる。"), MSGBOX_DEFAULT)

        case ROGUE_CAMPAIGN_CLASSIC:
            msgbox(format("{JPN}クラシックモードは むかしの ぼうけんに ちかい あそびかたに なる。\pいちばんの ちがいは いく さきを えらべなく なること。\pかならず きまった みちを すすむことに なる。\pどの ぼうけんでも つかえて せっていラボの せっていは かわらない。"))
            msgbox(format("{JPN}キャンペーンちゅうかどうかは ぼうけんの はじめに しらせが でる。"), MSGBOX_DEFAULT)

        case ROGUE_CAMPAIGN_MINIBOSS_BATTLER:
            msgbox(format("{JPN}バトルちゅうどくでは ルートの エンカウントが でなく なる。\pかわりに つよい トレーナーせんが でる。\pどの ぼうけんでも つかえて せっていラボの せっていは かわらない。\pスコアは ぼうけんちゅうに たおれた ポケモンの かずで きまる。\pすくないほど よい。"))
            msgbox(format("{JPN}キャンペーンちゅうかどうかは ぼうけんの はじめに しらせが でるし メニューで いまの スコアも みられる。"), MSGBOX_DEFAULT)

        case ROGUE_CAMPAIGN_AUTO_BATTLER:
            msgbox(format("{JPN}オートバトラーでは じぶんも あいても わざを ランダムに えらぶように なる。\pどの ぼうけんでも つかえて せっていラボの せっていは かわらない。\pスコアは ぼうけんちゅうに たおれた ポケモンの かずで きまる。\pすくないほど よい。"))
            msgbox(format("{JPN}キャンペーンちゅうかどうかは ぼうけんの はじめに しらせが でるし メニューで いまの スコアも みられる。"), MSGBOX_DEFAULT)

        case ROGUE_CAMPAIGN_LATERMANNER:
            msgbox(format("{JPN}レイターマナーモードは あの はいしんしゃの ための モードだ!\pこれは…!\pえっと…\pまあ モードだ…\pポケモンが たおれると スコアが はいる…\pあとは… じぶんで わかるだろう。"))
            msgbox(format("{JPN}キャンペーンちゅうかどうかは ぼうけんの はじめに しらせが でるし メニューで いまの スコアも みられる。"), MSGBOX_DEFAULT)

        case ROGUE_CAMPAIGN_POKEBALL_LIMIT:
            msgbox(format("{JPN}げんていほかくモードでは ボールの かずが かぎられ ぼうけんを クリアするのが もくひょうに なる。\pぼうけんちゅうは ボールを かうことも みつけることも できず ポケモンラボのような ポケモンを もらえる エンカウントも でなく なる。\pどの ぼうけんでも つかえて せっていラボの バッグリセットが つよせいされる。"))
            msgbox(format("{JPN}キャンペーンちゅうかどうかは ぼうけんの はじめに しらせが でる。"), MSGBOX_DEFAULT)

        case ROGUE_CAMPAIGN_ONE_HP:
            msgbox(format("{JPN}いちげきモードでは じぶんの ポケモンは どんな こうげきでも 1かいで たおれる。\pやせいの ポケモンとの バトルは ふつうどおり。\pどくや あられのような じわじわ くる ダメージも ふつうどおり。\pどの ぼうけんでも つかえて せっていラボの せっていは かわらない。\pスコアは たおれた ポケモンの かずで きまる。\pすくないほど よい。"))
            msgbox(format("{JPN}キャンペーンちゅうかどうかは ぼうけんの はじめに しらせが でるし メニューで いまの スコアも みられる。"), MSGBOX_DEFAULT)

        default:
            msgbox(format("???"))
    }
}

script Rogue_ConfigRoom_Campaign_Choice
{
    special(Rogue_BufferCampaignName)
    special(Rogue_GetCampaignHighScore)

    if(var(VAR_RESULT) == 0)
    {
        message(format("{JPN}{STR_VAR_1}キャンペーンを やってみるか?"))
    }
    else
    {
        buffernumberstring(STR_VAR_2, VAR_RESULT)
        message(format("{JPN}{STR_VAR_1}キャンペーンを あそびますか?\n「さいこうスコア {STR_VAR_2}」"))
    }

    waitmessage
    multichoice(20, 6, MULTI_YESNOINFO, YES)

    switch(var(VAR_RESULT))
    {
        case 0: // Yes
            waitse
            playse(SE_PIN)
            msgbox(format("{JPN}がんばれよ!"), MSGBOX_DEFAULT)

        case 2: // Info
            call(Rogue_ConfigRoom_Campaign_CampaignDescription)
            call(Rogue_ConfigRoom_Campaign_Choice)

        case 1: // No
        case MULTI_B_PRESSED:
            setvar(VAR_ROGUE_DESIRED_CAMPAIGN, ROGUE_CAMPAIGN_NONE)
    }
}

script Rogue_ConfigRoom_Campaign_ReplayChoice
{
    special(Rogue_BufferCampaignName)
    special(Rogue_GetCampaignHighScore)

    if(var(VAR_RESULT) == 0)
    {
        message(format("{JPN}{STR_VAR_1}キャンペーンを あそびますか?"))
    }
    else
    {
        buffernumberstring(STR_VAR_2, VAR_RESULT)
        message(format("{JPN}{STR_VAR_1}キャンペーンを あそびますか?\n「さいこうスコア {STR_VAR_2}」"))
    }

    waitmessage
    multichoice(20, 6, MULTI_YESNOINFO, NO)

    switch(var(VAR_RESULT))
    {
        case 0: // Yes
            waitse
            playse(SE_PIN)
            msgbox(format("{JPN}がんばれよ!"), MSGBOX_DEFAULT)

        case 2: // Info
            call(Rogue_ConfigRoom_Campaign_CampaignDescription)
            call(Rogue_ConfigRoom_Campaign_ReplayChoice)

        case 1: // No
        case MULTI_B_PRESSED:
            setvar(VAR_ROGUE_DESIRED_CAMPAIGN, ROGUE_CAMPAIGN_NONE)
    }
}

script Rogue_ConfigRoom_Campaign_NewPhrase
{
    msgbox(format("{JPN}…\pいま なんて?"))

    setvar(VAR_0x8004, EASY_CHAT_TYPE_ROGUE_CAMPAIGN)
    call(Common_ShowEasyChatScreen)
    
    if(var(VAR_ROGUE_DESIRED_CAMPAIGN) != ROGUE_CAMPAIGN_NONE)
    {
        faceplayer
        //completequest(QUEST_CampaignTease)

        special(Rogue_BufferCampaignName)
        msgbox(format("{JPN}おっと!\pそれは {STR_VAR_1}キャンペーンの\nあいことばじゃないか!"), MSGBOX_DEFAULT)

        if(var(VAR_TEMP_F) == YES)
        {
            msgbox(format("{JPN}キャンペーンに さんかすると\nとくべつな ちょうせんに なるよう\lせっていが かわる。\pてもちの ポケモンや バッグの\nどうぐを いれかえることも ある。\pせっていラボの せっていも\nかえることが ある。\pキャンペーンごとに きまった\nじゅんびと ルールが ある。"), MSGBOX_DEFAULT)
        }

        call(Rogue_ConfigRoom_Campaign_Choice)

        if(var(VAR_ROGUE_DESIRED_CAMPAIGN) == ROGUE_CAMPAIGN_NONE)
        {
            msgbox(format("{JPN}やってみたく なったら こえを かけてくれ。"), MSGBOX_DEFAULT)
        }
    }
    else
    {
        msgbox(format("{JPN}いや…\nそんなモードは しらないな…"), MSGBOX_DEFAULT)
    }
}

script Rogue_ConfigRoom_SelectCampaign_Loop
{
    special(Rogue_GetNextUnlockedCampaign)
    if(var(VAR_0x8004) != ROGUE_CAMPAIGN_NONE)
    {
        setvar(VAR_RESULT, YES)
    }
    else
    {
        setvar(VAR_RESULT, NO)
    }

    while(var(VAR_RESULT) == YES)
    {
        copyvar(VAR_ROGUE_DESIRED_CAMPAIGN, VAR_0x8004)
        call(Rogue_ConfigRoom_Campaign_ReplayChoice)

        if(var(VAR_ROGUE_DESIRED_CAMPAIGN) != ROGUE_CAMPAIGN_NONE)
        {
            setvar(VAR_RESULT, NO)
        }
        else
        {
            special(Rogue_GetNextUnlockedCampaign)
            if(var(VAR_0x8004) == ROGUE_CAMPAIGN_NONE)
            {
                // Ran out of campaigns
                setvar(VAR_RESULT, NO)
            }
            else
            {
                // Still got more to check
                setvar(VAR_RESULT, YES)
            }
        }
    }

    if(var(VAR_ROGUE_DESIRED_CAMPAIGN) == ROGUE_CAMPAIGN_NONE)
    {
        msgbox(format("{JPN}わるいが これで ぜんぶだ…"))
    }
}

script Rogue_ConfigRoom_Campaign
{
    lock

    special(Rogue_GetUnlockedCampaignCount)
    if(var(VAR_RESULT) == 0)
    {
        setvar(VAR_TEMP_F, YES)
        call(Rogue_ConfigRoom_Campaign_NewPhrase)
    }
    else
    {
        faceplayer
        msgbox(format("{JPN}よう!"))

        // Always mark this as complete as some people are not getting it first time?
        //completequest(QUEST_CampaignTease)

        if(var(VAR_ROGUE_DESIRED_CAMPAIGN) != ROGUE_CAMPAIGN_NONE)
        {
            call(Rogue_ConfigRoom_Campaign_Choice)

            if(var(VAR_ROGUE_DESIRED_CAMPAIGN) == ROGUE_CAMPAIGN_NONE)
            {
                msgbox(format("{JPN}もういちど やりたく なったら\nこえを かけてくれ。"), MSGBOX_DEFAULT)
            }
        }
        else
        {
            // Additional options
            message(format("{JPN}どうかしたか?"))
            waitmessage

            multichoice(20, 6, MULTI_CAMPAIGN_EXT_OPT, NO)

            switch(var(VAR_RESULT))
            {
                case 0: // Play Campaign
                    setvar(VAR_0x8004, ROGUE_CAMPAIGN_NONE)
                    call(Rogue_ConfigRoom_SelectCampaign_Loop)

                case 1: // New Phrase
                    setvar(VAR_TEMP_F, NO)
                    call(Rogue_ConfigRoom_Campaign_NewPhrase)

                //case 2:
                //case MULTI_B_PRESSED: 
            }
        }
    }

    release
}

script Rogue_ConfigRoom_WalkAboveAssistant
{
    lockall

    if(flag(FLAG_SET_SEED_ENABLED) == FALSE)
    {
        lockall
        applymovement(OBJ_ASSISTANT_ID, ConfigRoom_LookUp)
        applymovement(OBJ_EVENT_ID_PLAYER, ConfigRoom_LookDown)
        waitmovement(0)

        setflag(FLAG_SEED_APPLY_MOVEMENT)
        call(Rogue_ConfigRoom_TalkAssistantInternal)
    }

    releaseall
}

script Rogue_ConfigRoom_WalkBelowAssistant
{
    lockall

    if(flag(FLAG_SET_SEED_ENABLED) == FALSE)
    {
        applymovement(OBJ_ASSISTANT_ID, ConfigRoom_LookDown)
        applymovement(OBJ_EVENT_ID_PLAYER, ConfigRoom_LookUp)
        waitmovement(0)

        setflag(FLAG_SEED_APPLY_MOVEMENT)
        call(Rogue_ConfigRoom_TalkAssistantInternal)
    }

    releaseall
}

movement ConfigRoom_LookUp {
    face_up
}

movement ConfigRoom_LookDown {
    face_down
}

movement ConfigRoom_LookLeft {
    face_left
}

movement ConfigRoom_WalkLeft {
    walk_left
}

script Rogue_ConfigRoom_TalkHiddenEnterance
{
    if(flag(FLAG_ROGUE_UNCOVERRED_POKABBIE) == FALSE)
    {
        lock

        msgbox(format("{JPN}なんだこれ?\pかくしスイッチだ!\pスイッチを おしますか?"), MSGBOX_YESNO)

        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("{JPN}けいこく!\nこのスイッチを おすと クリアご\lようそが さきに かいほうされる。\pふつうに 1かい クリアしてから\nおすことを おすすめする。\pスイッチを おしますか?"), MSGBOX_YESNO)

            if(var(VAR_RESULT) == YES)
            {
                setflag(FLAG_ROGUE_UNCOVERRED_POKABBIE)

                waitse
                playse(SE_TRUCK_DOOR)
                call(Rogue_ConfigRoom_RedrawMap)
            }
        }

        release
    }
}

script Rogue_ConfigRoom_MeetPokabbie
{
    lockall

    playse(SE_PIN)
    applymovement(OBJ_POKABBIE_ID, ConfigRoom_Pokabbie_NoticePlayer)
    waitmovement(0)

    if(flag(FLAG_IS_CHAMPION))
    {
        msgbox(format("{JPN}ポカビー: やあ {PLAYER}!\pぼくの ラボへ ようこそ!\nいや じしょうするなら…\pエクスパンションルーム!"))
        msgbox(format("{JPN}このへやで とくべつモードを\nつかえるように できる。\pいまは すくないけど これからも\nふやしていくよ!\pゆっくり みていってくれ!"))
    }
    else
    {
        msgbox(format("{JPN}???: なんで ここに!\pもう ひみつのラボを\nみつけてしまったのか!"))

        applymovement(OBJ_POKABBIE_ID, ConfigRoom_Pokabbie_FaceUp)
        waitmovement(0)

        msgbox(format("{JPN}せめて チャンピオンを たおすまで\nまつ つもりだったのに…"))

        applymovement(OBJ_POKABBIE_ID, ConfigRoom_Pokabbie_FaceDown)
        waitmovement(0)

        msgbox(format("{JPN}それはさておき!\pしつれいした!\nじこしょうかいを させてくれ!"))

        applymovement(OBJ_POKABBIE_ID, ConfigRoom_Pokabbie_Spin)
        waitmovement(0)

        msgbox(format("{JPN}なまえは アビー!\nポカビーと よんでくれ!"))

        msgbox(format("{JPN}ポカビー: エメラルドローグを\nつくっている かいはつしゃだ!\pぼくの ラボへ ようこそ!\nいや じしょうするなら…\pエクスパンションルーム!"))
        msgbox(format("{JPN}このへやで とくべつモードを\nつかえるように できる。\pいまは すくないけど これからも\nふやしていくよ!\pゆっくり みていってくれ!"))
    }

    //completequest(QUEST_MeetPokabbie)
    setflag(FLAG_ROGUE_MET_POKABBIE)
    setvar(VAR_TEMP_1, 1)

    releaseall
}

script Rogue_ConfigRoom_TalkPokabbie
{
    lockall

    faceplayer
    msgbox(format("{JPN}ポカビー: エメラルドローグを\nたのしんでくれてると うれしいな!\pこのへやから とくべつモードを\nじゆうに ためしてくれ!\pこれからも ふやしていくよ!"), MSGBOX_DEFAULT)

    applymovement(OBJ_POKABBIE_ID, ConfigRoom_Pokabbie_Spin)
    waitmovement(0)

    releaseall
}

script Rogue_ConfigRoom_TalkDitto
{
    lock

    playmoncry(SPECIES_DITTO, CRY_MODE_NORMAL)
    msgbox(format("{JPN}メタモンだ!\pなぜ ここに?"), MSGBOX_DEFAULT)

    release
}

movement ConfigRoom_Pokabbie_FaceDown 
{
    face_down
}

movement ConfigRoom_Pokabbie_FaceUp 
{
    face_up
}

movement ConfigRoom_Pokabbie_NoticePlayer 
{
    face_down
    emote_exclamation_mark
}

movement ConfigRoom_Pokabbie_Spin 
{
    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1

    face_down
    delay_1
    
    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1

    face_down
    delay_1
}

script Rogue_ConfigRoom_MegaBag
{
    lock

    poryswitch(ROGUE_VERSION)
    {
        ROGUE_VERSION_VANILLA
        {
            msgbox(format("{JPN}メモの ついた ふくろだ…\pつうじょうばんを あそんでくれて ありがとう!\pEXばんでは この へやで あとの せだいの ポケモンを つかえるように できる!\pおもしろそうなら EXばんで あたらしく はじめて せっていラボの まどを しらべれば すぐに この へやを つかえるよ。"))
        }
        ROGUE_VERSION_EXPANSION
        {
            bufferitemname(STR_VAR_1, ITEM_MEGA_RING)
            checkitem(ITEM_MEGA_RING)

            if(var(VAR_RESULT) == NO)
            {
                msgbox(format("{JPN}{STR_VAR_1}を うけとりますか?"), MSGBOX_YESNO)
                if(var(VAR_RESULT) == YES)
                {
                    giveitem(ITEM_MEGA_RING)
                }
            }
            else
            {
                msgbox(format("{JPN}{STR_VAR_1}を もどしますか?"), MSGBOX_YESNO)
                if(var(VAR_RESULT) == YES)
                {
                    msgbox(format("{JPN}{STR_VAR_1}を バッグに もどした。"), MSGBOX_DEFAULT)
                    removeitem(ITEM_MEGA_RING)
                }
            }
        }
    }

    release
}

script Rogue_ConfigRoom_ZMoveBag
{
    lock

    poryswitch(ROGUE_VERSION)
    {
        ROGUE_VERSION_VANILLA
        {
            msgbox(format("{JPN}メモの ついた ふくろだ…\pつうじょうばんを あそんでくれて ありがとう!\pEXばんでは この へやで あとの せだいの ポケモンを つかえるように できる!\pおもしろそうなら EXばんで あたらしく はじめて せっていラボの まどを しらべれば すぐに この へやを つかえるよ。"))
        }
        ROGUE_VERSION_EXPANSION
        {
            bufferitemname(STR_VAR_1, ITEM_Z_POWER_RING)
            checkitem(ITEM_Z_POWER_RING)

            if(var(VAR_RESULT) == NO)
            {
                msgbox(format("{JPN}{STR_VAR_1}を うけとりますか?"), MSGBOX_YESNO)
                if(var(VAR_RESULT) == YES)
                {
                    giveitem(ITEM_Z_POWER_RING)
                }
            }
            else
            {
                msgbox(format("{JPN}{STR_VAR_1}を もどしますか?"), MSGBOX_YESNO)
                if(var(VAR_RESULT) == YES)
                {
                    msgbox(format("{JPN}{STR_VAR_1}を バッグに もどした。"), MSGBOX_DEFAULT)
                    removeitem(ITEM_Z_POWER_RING)
                }
            }
        }
    }

    release
}

