
const NPC_HOST = 1

const FAIL_ROUND_COUNTER = 100
const STOP_ROUND_COUNTER = 99

const GAME_CATEGORY_SKILL = 0
const GAME_CATEGORY_LUCK = 1

const FLAG_HIDE_HOST = FLAG_TEMP_1

const VAR_CURRENT_ROUND = VAR_TEMP_0
const VAR_GAMESHOW_TRIGGERED = VAR_TEMP_1
const VAR_CURRENT_REWARD_COUNTER = VAR_TEMP_2
const VAR_CURRENT_REWARD_ITEM = VAR_TEMP_3
const VAR_CURRENT_REWARD_COUNT = VAR_TEMP_4
const VAR_GAME_CATEGORY = VAR_TEMP_5

// WTP Vars
const VAR_CURRENT_SPECIES = VAR_TEMP_A

// Triva Var
const VAR_TRIVIA_ANSWER = VAR_TEMP_A

// Voltorb flip vars
const VAR_VOLTORB_FLIP_LVL = VAR_0x8004

// Coin flip vars
const VAR_COIN_FLIP_RESULT = VAR_TEMP_A

// Higher Lower vars
const VAR_HIGHER_LOWER_CURR_NUM = VAR_TEMP_A
const VAR_HIGHER_LOWER_NEXT_NUM = VAR_TEMP_B


mapscripts Rogue_Encounter_GameShow_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Encounter_GameShow_OnLoad
}

script Rogue_Encounter_GameShow_OnLoad
{
    special(GameShow_RestartGameShow)

    setvar(VAR_CURRENT_REWARD_COUNTER, 0)
    special(GameShow_SelectRewardItem)

    clearflag(FLAG_HIDE_HOST)
}

script Rogue_Encounter_GameShow_TriggerIntro
{
    lockall

    setvar(VAR_GAMESHOW_TRIGGERED, 1)
    msgbox(format("{JPN}いよーう!"), MSGBOX_DEFAULT)

    applymovement(NPC_HOST, GameShow_Host_Spin)
    waitmovement(0)

    setweather(WEATHER_NONE)
    doweather
    playse(SE_TRUCK_DOOR)
    delay(30)

    playbgm(MUS_HG_GAME_CORNER, TRUE)

    msgbox(format("{JPN}あいじょうたっぷりに よういした\nゲームショーへ ようこそ!\pきょうは こんな すてきな しょうひんが\nてに はいるかもよ!"), MSGBOX_DEFAULT)

    closemessage
    playse(SE_APPLAUSE)
    //waitse
    
    special(GameShow_UpdateRewardVisibility)

    msgbox(format("{JPN}さて ちょうせんしゃ!\nこの ゲームショーの ルールは しってる?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("{JPN}すばらしい!\nさっそく はじめよう!"), MSGBOX_DEFAULT)
    }
    else
    {
        msgbox(format("{JPN}ゲームショーでは まいかい\nあそぶ ゲームが きまっている。\pゲームは いくつかの ラウンドで\nできている。\pラウンドを クリアすると しょうひんが\nもらえて そこで やめるか\lもっと いい しょうひんを ねらって\lつづけるか えらべる!\pいちかばちかだ!"), MSGBOX_DEFAULT)
    }

    begindynamicmultichoice
    appenddynamicmultichoice("{JPN}うでまえの ゲーム", GAME_CATEGORY_SKILL)
    appenddynamicmultichoice("{JPN}うんだめしの ゲーム", GAME_CATEGORY_LUCK)

    message(format("{JPN}さて どの しゅるいの ゲームで あそぶ?"))
    waitmessage
    enddynamicmultichoice(19, 7, 2, FALSE)
    copyvar(VAR_GAME_CATEGORY, VAR_RESULT)


    msgbox(format("{JPN}きょうの ショーの ゲームは… … …"), MSGBOX_DEFAULT)

    if(var(VAR_GAME_CATEGORY) == GAME_CATEGORY_SKILL)
    {
        special(GameShow_IsTeamTriviaRoundValid)
        if(var(VAR_RESULT) == YES)
        {
            random(5)
        }
        else
        {
            random(4)
        }

        switch(var(VAR_RESULT))
        {
            // Weight this higher as it's more accessible
            case 0:
                call(Rogue_Encounter_GameShow_WhosThatPokemonFlow)

            case 1:
            case 2:
                call(Rogue_Encounter_GameShow_WhosThatCryFlow)

            case 3:
                call(Rogue_Encounter_GameShow_VoltorbFlip)

            case 4:
                call(Rogue_Encounter_GameShow_TeamTrivia)
        }
    }
    else // GAME_CATEGORY_LUCK
    {
        random(2)

        switch(var(VAR_RESULT))
        {
            case 0:
                call(Rogue_Encounter_GameShow_CoinFlip)

            case 1:
                call(Rogue_Encounter_GameShow_HigherLower)
        }
    }

    applymovement(NPC_HOST, GameShow_Host_Spin)
    waitmovement(0)

    msgbox(format("{JPN}きょうは ここまで!\nケケケ"), MSGBOX_DEFAULT)
    special(GameShow_UpdateRewardVisibility)

    applymovement(NPC_HOST, GameShow_Host_Exit)
    waitmovement(0)

    setobjectxy(NPC_HOST, 0, 0)
    setobjectxyperm(NPC_HOST, 0, 0)
    hideobjectat(NPC_HOST, MAP_ROGUE_ENCOUNTER_GAME_SHOW)
    setflag(FLAG_HIDE_HOST)

    releaseall
}

script Rogue_Interact_GiveReward
{
    lock

    if(var(VAR_CURRENT_REWARD_ITEM) == ITEM_NONE)
    {
        msgbox(format("{JPN}おや。\pメモが ついている:\p「ズルは みのらない ケケケ ランドマン」"))

        playmoncry(SPECIES_ELECTRODE, CRY_MODE_ENCOUNTER)
        waitmoncry

        removeobject(VAR_LAST_TALKED)

        seteventmon(SPECIES_ELECTRODE, 1)

        special(BattleSetup_StartLegendaryBattle)
        waitstate
    }
    else
    {
        checkitemspace(VAR_CURRENT_REWARD_ITEM, VAR_CURRENT_REWARD_COUNT)
        if(var(VAR_RESULT) == YES)
        {
            finditem(VAR_CURRENT_REWARD_ITEM, VAR_CURRENT_REWARD_COUNT)
            removeobject(VAR_LAST_TALKED)
        }
        else
        {
            // Call this just so it displays the "can't pick up message"
            finditem(VAR_CURRENT_REWARD_ITEM, VAR_CURRENT_REWARD_COUNT)
        }
    }

    release
}

script Rogue_Encounter_GameShow_WhosThatPokemonFlow
{
    msgbox(format("{JPN}だれだ この ポケモン?!\p6ラウンドで ヒントから ポケモンを\nあてて もらう。\pさあ…"), MSGBOX_DEFAULT)

    while(var(VAR_CURRENT_ROUND) <= 50)
    {
        buffernumberstring(STR_VAR_1, VAR_CURRENT_ROUND)
        msgbox(format("{JPN}ラウンド{STR_VAR_1}!"))

        special(GameShow_SelectRandomSpecies)
        specialvar(VAR_CURRENT_SPECIES, GameShow_BufferSpecies)

        //  rounds of sillouettes
        message(format("{JPN}この シルエットは どの ポケモン?"))
        showmonpic(VAR_CURRENT_SPECIES, 10, 3, TRUE)
        delay(20)
        waitmessage
        waitbuttonpress
        hidemonpic


        message(format("{JPN}いまのは どの ポケモン?"))
        waitmessage

        begindynamicmultichoice
        special(GameShow_AppendSpeciesMultichoiceOptions)
        enddynamicmultichoice(19, 4, 4, FALSE)

        msgbox(format("{JPN}こたえは…"))

        if(var(VAR_RESULT) == YES)
        {
            playse(SE_DING_DONG)
            waitse

            msgbox(format("{JPN}せいかい!"))
            addvar(VAR_CURRENT_ROUND, 1)
            addvar(VAR_CURRENT_REWARD_COUNTER, 1)

            call(Rogue_Encounter_GameShow_DisplayReward)
        }
        else
        {
            playse(SE_BOO)
            waitse

            bufferspeciesname(STR_VAR_1, VAR_CURRENT_SPECIES)

            msgbox(format("{JPN}ざんねん!\nこたえは {STR_VAR_1}だった。"))
            setvar(VAR_CURRENT_ROUND, FAIL_ROUND_COUNTER)
        }
    }
}

script Rogue_Encounter_GameShow_WhosThatCryFlow
{
    msgbox(format("{JPN}だれの なきごえ?!\p6ラウンドで なきごえから ポケモンを\nあてて もらう。\pさあ…"), MSGBOX_DEFAULT)

    while(var(VAR_CURRENT_ROUND) <= 50)
    {
        buffernumberstring(STR_VAR_1, VAR_CURRENT_ROUND)
        msgbox(format("{JPN}ラウンド{STR_VAR_1}!"))

        special(GameShow_SelectRandomSpecies)
        specialvar(VAR_CURRENT_SPECIES, GameShow_BufferSpecies)

        // rounds of guess the cry
        message(format("{JPN}この なきごえは どの ポケモン?"))
        waitmessage
        delay(30)

        playmoncry(VAR_CURRENT_SPECIES, CRY_MODE_NORMAL)
        waitmoncry
        delay(90)

        playmoncry(VAR_CURRENT_SPECIES, CRY_MODE_NORMAL)
        waitmoncry
        delay(90)

        playmoncry(VAR_CURRENT_SPECIES, CRY_MODE_NORMAL)
        waitmoncry
        delay(90)


        message(format("{JPN}いまの なきごえは どの ポケモン?"))
        waitmessage

        begindynamicmultichoice
        special(GameShow_AppendSpeciesMultichoiceOptions)
        enddynamicmultichoice(20, 7, 4, FALSE)

        msgbox(format("{JPN}こたえは…"))

        if(var(VAR_RESULT) == YES)
        {
            playse(SE_DING_DONG)
            waitse

            msgbox(format("{JPN}せいかい!"))
            addvar(VAR_CURRENT_ROUND, 1)
            addvar(VAR_CURRENT_REWARD_COUNTER, 1)

            call(Rogue_Encounter_GameShow_DisplayReward)
        }
        else
        {
            playse(SE_BOO)
            waitse

            bufferspeciesname(STR_VAR_1, VAR_CURRENT_SPECIES)

            msgbox(format("{JPN}ざんねん!\nこたえは {STR_VAR_1}だった。"))
            setvar(VAR_CURRENT_ROUND, FAIL_ROUND_COUNTER)
        }
    }
}

script Rogue_Encounter_GameShow_VoltorbFlip
{
    msgbox(format("{JPN}ビリリダマめくり!\p3ラウンド。ビリリダマを めくらずに\n2と 3の カードを すべて あつめよう。\pさあ…"), MSGBOX_DEFAULT)

    setvar(VAR_VOLTORB_FLIP_LVL, 0)

    while(var(VAR_CURRENT_ROUND) <= 50)
    {
        buffernumberstring(STR_VAR_1, VAR_CURRENT_ROUND)
        msgbox(format("{JPN}ラウンド{STR_VAR_1}!"))

        special(Special_ViewVoltorbFlip)
        waitstate

        if(var(VAR_RESULT) == YES)
        {
            playse(SE_DING_DONG)
            waitse

            msgbox(format("{JPN}おめでとう!"))
            addvar(VAR_CURRENT_ROUND, 1)
            addvar(VAR_CURRENT_REWARD_COUNTER, 2)
            addvar(VAR_VOLTORB_FLIP_LVL, 2)

            call(Rogue_Encounter_GameShow_DisplayReward)
        }
        else
        {
            playse(SE_BOO)
            waitse

            msgbox(format("{JPN}ざんねん!"))
            setvar(VAR_CURRENT_ROUND, FAIL_ROUND_COUNTER)
        }
    }
}

script Rogue_Encounter_GameShow_TeamTrivia 
{
    msgbox(format("{JPN}てもちクイズ!\p6ラウンド。きみの てもちに ついての\nしつもんに こたえるだけ。\pかんたんだろう!\pさあ…"), MSGBOX_DEFAULT)

    while(var(VAR_CURRENT_ROUND) <= 50)
    {
        buffernumberstring(STR_VAR_1, VAR_CURRENT_ROUND)
        msgbox(format("{JPN}ラウンド{STR_VAR_1}!"))

        bufferstring(STR_VAR_1, format("{JPN}1"))
        bufferstring(STR_VAR_2, format("{JPN}2"))
        bufferstring(STR_VAR_3, format("{JPN}3"))
        setvar(VAR_TRIVIA_ANSWER, 0)
        

        special(GameShow_NextTriviaQuestion)

        switch(var(VAR_RESULT))
        {
            case 0:
                message(format("{JPN}それで なにを かける?"))

            default:
                message(format("???"))
        }
        call(Rogue_Encounter_GameShow_TeamTrivia_GetResult)

        if(var(VAR_RESULT) == YES)
        {
            playse(SE_DING_DONG)
            waitse

            msgbox(format("{JPN}せいかい!"))
            addvar(VAR_CURRENT_ROUND, 1)
            addvar(VAR_CURRENT_REWARD_COUNTER, 1)

            call(Rogue_Encounter_GameShow_DisplayReward)
        }
        else
        {
            playse(SE_BOO)
            waitse

            switch(var(VAR_TRIVIA_ANSWER))
            {
                case 0:
                    msgbox(format("{JPN}ざんねん!\nこたえは {STR_VAR_1}だった。"))
                case 1:
                    msgbox(format("{JPN}ざんねん!\nこたえは {STR_VAR_2}だった。"))
                case 2:
                    msgbox(format("{JPN}ざんねん!\nこたえは {STR_VAR_3}だった。"))
            }

            setvar(VAR_CURRENT_ROUND, FAIL_ROUND_COUNTER)
        }
    }
}

script Rogue_Encounter_GameShow_TeamTrivia_GetResult
{
    waitmessage
    multichoice(20, 6, MULTI_EXPAND3, NO)

    switch(var(VAR_RESULT))
    {
        case 0:
        case 1:
        case 2:
            if(var(VAR_RESULT) == VAR_TRIVIA_ANSWER)
            {
                setvar(VAR_RESULT, YES)
            }
            else
            {
                setvar(VAR_RESULT, NO)
            }
        case MULTI_B_PRESSED:
            setvar(VAR_RESULT, NO)
    }

    msgbox(format("{JPN}こたえは…"))
}

script Rogue_Encounter_GameShow_DisplayReward
{
    special(GameShow_UpdateRewardVisibility)

    copyvar(VAR_0x8004, VAR_CURRENT_REWARD_ITEM)
    copyvar(VAR_0x8005, VAR_CURRENT_REWARD_COUNT)
    special(GameShow_SelectRewardItem)
    bufferitemnameplural(STR_VAR_1, VAR_0x8004, VAR_0x8005) // current reward if stop now
    bufferitemnameplural(STR_VAR_2, VAR_CURRENT_REWARD_ITEM, VAR_CURRENT_REWARD_COUNT) // next reward

    if(var(VAR_CURRENT_REWARD_ITEM) == ITEM_NONE)
    {
        msgbox(format("{JPN}ここで やめれば てに はいるのは…\p{STR_VAR_1}!\pもっと ねらうなら さらに…\p{STR_VAR_2}!\nいや もっと うえも!\nいちかばちかだ!\pさあ かけて もう1ラウンド あそぶ?"), MSGBOX_YESNO)
    
        if(var(VAR_RESULT) == NO)
        {
            copyvar(VAR_CURRENT_REWARD_ITEM, VAR_0x8004)
            copyvar(VAR_CURRENT_REWARD_COUNT, VAR_0x8005)
            setvar(VAR_CURRENT_ROUND, STOP_ROUND_COUNTER)
        }
    }
    else
    {
        if(var(VAR_CURRENT_REWARD_COUNTER) >= 6)
        {
            msgbox(format("{JPN}てに はいったのは…\p{STR_VAR_1}!"))
            setvar(VAR_RESULT, NO)
            copyvar(VAR_CURRENT_REWARD_ITEM, VAR_0x8004)
            copyvar(VAR_CURRENT_REWARD_COUNT, VAR_0x8005)
            setvar(VAR_CURRENT_ROUND, STOP_ROUND_COUNTER)

            quest_trigger(QUEST_TRIGGER_MAP_SPECIFIC_EVENT)
        }
        else
        {
            msgbox(format("{JPN}てに はいったのは…\p{STR_VAR_1}!\pつぎの ラウンドでは さらに…\p{STR_VAR_2}!\pかけて もう1ラウンド あそぶ?"), MSGBOX_YESNO)
        
            if(var(VAR_RESULT) == NO)
            {
                copyvar(VAR_CURRENT_REWARD_ITEM, VAR_0x8004)
                copyvar(VAR_CURRENT_REWARD_COUNT, VAR_0x8005)
                setvar(VAR_CURRENT_ROUND, STOP_ROUND_COUNTER)
            }
        }
    }
}

script Rogue_Encounter_GameShow_CoinFlip
{
    msgbox(format("{JPN}コイントス!\p6ラウンド。おもてか うらかを あてるだけ。\pさあ…"), MSGBOX_DEFAULT)

    while(var(VAR_CURRENT_ROUND) <= 50)
    {
        buffernumberstring(STR_VAR_1, VAR_CURRENT_ROUND)
        msgbox(format("{JPN}ラウンド{STR_VAR_1}!"))

        begindynamicmultichoice
        appenddynamicmultichoice("{JPN}おもて", 0)
        appenddynamicmultichoice("{JPN}うら", 1)

        message(format("{JPN}コインは どっちに なると おもう?"))
        waitmessage
        enddynamicmultichoice(19, 7, 2, FALSE)
        copyvar(VAR_COIN_FLIP_RESULT, VAR_RESULT)

        random(2)
        if(var(VAR_COIN_FLIP_RESULT) == 1) // invert for tails
        {
            if(var(VAR_RESULT) == 1)
            {
                setvar(VAR_RESULT, 0)
            }
            else
            {
                setvar(VAR_RESULT, 1)
            }
        }

        if(var(VAR_RESULT) == TRUE)
        {
            playse(SE_DING_DONG)
            waitse

            msgbox(format("{JPN}せいかい!"))
            addvar(VAR_CURRENT_ROUND, 1)
            addvar(VAR_CURRENT_REWARD_COUNTER, 1)

            call(Rogue_Encounter_GameShow_DisplayReward)
        }
        else
        {
            playse(SE_BOO)
            waitse

            msgbox(format("{JPN}ざんねん!"))
            setvar(VAR_CURRENT_ROUND, FAIL_ROUND_COUNTER)
        }
    }
}

script Rogue_Encounter_GameShow_HigherLower
{
    msgbox(format("{JPN}ハイ アンド ロー!\p6ラウンド。1から 100の すうじを\nみせるから つぎが うえか したかを\lこたえてくれ。\pさあ…"), MSGBOX_DEFAULT)  

    // rng initial num
    random(100)
    addvar(VAR_RESULT, 1)
    copyvar(VAR_HIGHER_LOWER_CURR_NUM, VAR_RESULT)

    while(var(VAR_CURRENT_ROUND) <= 50)
    {
        buffernumberstring(STR_VAR_1, VAR_CURRENT_ROUND)
        msgbox(format("{JPN}ラウンド{STR_VAR_1}!"))

        // rng next num
        random(100)
        addvar(VAR_RESULT, 1)
        copyvar(VAR_HIGHER_LOWER_NEXT_NUM, VAR_RESULT)

        begindynamicmultichoice
        appenddynamicmultichoice("{JPN}うえ", 0)
        appenddynamicmultichoice("{JPN}した", 1)

        buffernumberstring(STR_VAR_1, VAR_HIGHER_LOWER_CURR_NUM)
        buffernumberstring(STR_VAR_2, VAR_HIGHER_LOWER_NEXT_NUM)
        message(format("{JPN}いまの すうじは {STR_VAR_1}。\nつぎは どっちだと おもう?"))
        waitmessage
        enddynamicmultichoice(19, 7, 2, FALSE)

        if(var(VAR_RESULT) == 0) // higher
        {
            if(var(VAR_HIGHER_LOWER_NEXT_NUM) > VAR_HIGHER_LOWER_CURR_NUM)
            {
                setvar(VAR_RESULT, TRUE)
            }
            else
            {
                setvar(VAR_RESULT, FALSE)
            }
        }
        else // lower
        {
            if(var(VAR_HIGHER_LOWER_NEXT_NUM) < VAR_HIGHER_LOWER_CURR_NUM)
            {
                setvar(VAR_RESULT, TRUE)
            }
            else
            {
                setvar(VAR_RESULT, FALSE)
            }
        }

        buffernumberstring(STR_VAR_1, VAR_HIGHER_LOWER_NEXT_NUM)

        if(var(VAR_RESULT) == TRUE)
        {
            playse(SE_DING_DONG)
            waitse

            msgbox(format("{JPN}せいかい!\nつぎの すうじは {STR_VAR_1}だった!"))
            addvar(VAR_CURRENT_ROUND, 1)
            addvar(VAR_CURRENT_REWARD_COUNTER, 1)

            call(Rogue_Encounter_GameShow_DisplayReward)
        }
        else
        {
            playse(SE_BOO)
            waitse

            msgbox(format("{JPN}ざんねん!\nつぎの すうじは {STR_VAR_1}だった!"))
            setvar(VAR_CURRENT_ROUND, FAIL_ROUND_COUNTER)
        }

        copyvar(VAR_HIGHER_LOWER_CURR_NUM, VAR_HIGHER_LOWER_NEXT_NUM)
    }
}

movement GameShow_Host_Spin
{
    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1

    face_down
    delay_1
    
    face_right
    delay_1

    face_up
    delay_1

    face_left
    delay_1

    face_down
    delay_1

    jump_in_place_down
}

movement GameShow_Host_Exit {
    jump_2_up * 2
}