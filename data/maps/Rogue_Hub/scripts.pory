script RogueHub_ChangeMonBall
{
    lock
    faceplayer

    setvar(VAR_0x8004, 0)
    special(BufferMonNickname)

    msgbox(format("{JPN}やあ!\pのぞむなら {STR_VAR_1}の ボールを かえられるよ?"), MSGBOX_YESNO)

    if(var(VAR_RESULT) == YES)
    {
        msgbox(format("{JPN}どの ボールに かえる?"))

        fadescreen(FADE_TO_BLACK)
        special(Bag_ChooseBall)
        waitstate

        
        if(var(VAR_ITEM_ID) == 0)
        {
            setvar(VAR_RESULT, NO)
        }
        else
        {
            removeitem(VAR_ITEM_ID, 1)
            special(Rogue_ChangeMonBall)

            msgbox(format("{JPN}はい できた!"), MSGBOX_DEFAULT)
            setvar(VAR_RESULT, YES)
        }

    }

    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("{JPN}そう… わかった…"), MSGBOX_DEFAULT)
    }

    release
}

script RogueHub_CombineMons
{
    lock

    msgbox(format("{JPN}ここの じめんから つよい いぶつを みつけたんだ…\pほればほるほど…\nもっと みつかる…\pみつけた いぶつには とくていの ポケモンを がったいさせる ちからが ある!"), MSGBOX_DEFAULT)

    specialvar(VAR_RESULT, CalculatePlayerPartyCount)
    faceplayer
    if(var(VAR_RESULT) > 1)
    {
        msgbox(format("{JPN}きみの ポケモンを 2ひき しらべようか?"), MSGBOX_YESNO)
    
        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("{JPN}どの ポケモンを しらべる?"), MSGBOX_DEFAULT)

            // 1st mon
            special(ChoosePartyMon)
            waitstate
            copyvar(VAR_0x8003, VAR_0x8004)

            if(var(VAR_0x8003) == PARTY_NOTHING_CHOSEN)
            {
                setvar(VAR_RESULT, NO)
            }

            // 2nd mon
            if(var(VAR_RESULT) == YES)
            {
                special(ChoosePartyMon)
                waitstate

                if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
                {
                    setvar(VAR_RESULT, NO)
                }
            }

            if(var(VAR_RESULT) == YES)
            {
                if(var(VAR_0x8003) == VAR_0x8004)
                {
                    msgbox(format("{JPN}おなじ ポケモンどうしは がったいできない…"), MSGBOX_DEFAULT)
                }
                else
                {
                    special(Rogue_CheckMonCombo)

                    if(var(VAR_0x8005) != 0)
                    {
                        bufferitemname(STR_VAR_1, VAR_0x8005)
                        bufferspeciesname(STR_VAR_2, VAR_0x8006)
        
                        msgbox(format("{JPN}おお!\nいぶつが!\p{STR_VAR_1}が はんのうしている!\pなんだって {STR_VAR_1}…?\pふむ…"), MSGBOX_DEFAULT)
                        msgbox(format("{JPN}その ポケモンたちは がったいできる!\pただし いちど やると…\nもとには もどせない…\pがったいさせるかい?"), MSGBOX_YESNO)

                        if(var(VAR_RESULT) == YES)
                        {
                            fadescreen(FADE_TO_BLACK)
                            playfanfare(MUS_AWAKEN_LEGEND)
                            special(Rogue_ApplyMonCombo)
                            waitfanfare

                            playmoncry(VAR_0x8006, CRY_MODE_ENCOUNTER)
                            waitmoncry

                            fadescreen(FADE_FROM_BLACK)
    
                            msgbox(format("{JPN}{STR_VAR_2}が めざめた!"), MSGBOX_DEFAULT)
                        }
                    }
                    else
                    {
                        msgbox(format("{JPN}ふむ…\nいぶつは はんのうしないようだ…"), MSGBOX_DEFAULT)
                        setvar(VAR_RESULT, YES)
                    }
                }
            }
        }

        if(var(VAR_RESULT) == NO)
        {
            msgbox(format("{JPN}ざんねん…\nいぶつが かなしむな…"), MSGBOX_DEFAULT)
        }
    }
    else
    {
        msgbox(format("{JPN}ポケモンを 2ひき つれてくれば しらべるよ… よければ…"), MSGBOX_DEFAULT)
    }

    release
}

