const VAR_STOP_TUTORIAL = VAR_TEMP_0

mapscripts Rogue_Interior_PokeConnect_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Interior_PokeConnect_OnMapLoad
}

script Rogue_Interior_PokeConnect_OnMapLoad
{
    if(flag(FLAG_ROGUE_ASSISTANT_TUTORIAL))
    {
        setvar(VAR_STOP_TUTORIAL, 1)
    }
    else
    {
        setvar(VAR_STOP_TUTORIAL, 0)
    }
}

script Rogue_Interior_PokeConnect_TalkMultiplayer
{
    lock

    special(Rogue_IsMultiplayerActive)
    if(var(VAR_RESULT) == TRUE)
    {
        msgbox(format("{JPN}やあ {PLAYER}!\pマルチプレイの ぼうけんを たのしめているかな!"), MSGBOX_DEFAULT)
    
        special(Rogue_IsMultiplayerHost)
        if(var(VAR_RESULT) == TRUE)
        {
            msgbox(format("{JPN}ホストを やめますか?"), MSGBOX_YESNO)
        }
        else
        {
            msgbox(format("{JPN}せつぞくを きって もどりますか?"), MSGBOX_YESNO)
        }

        if(var(VAR_RESULT) == TRUE)
        {
            special(Rogue_CloseMultiplayer)
            msgbox(format("{JPN}おかえり!\pマルチプレイの ぼうけんは たのしめたかな!"), MSGBOX_DEFAULT)
        }
    }
    else
    {
        msgbox(format("{JPN}やあ {PLAYER}!\pともだちと マルチプレイの ぼうけんを\nはじめる てつだいを するよ!"), MSGBOX_DEFAULT)

        msgbox(format("{JPN}{COLOR RED}けいこく!\n{COLOR DARK_GRAY}この きのうは まだ アルファばんです。\pかいはつちゅうの ため ただしく\nうごかない ぶぶんが あります。\pつかう あいだは こまめに レポートを\nかいて バックアップも とって ください。"))

        call(Rogue_Common_WaitForRogueAssistant)

        if(var(VAR_RESULT) == TRUE)
        {
            call(Common_EventScript_SaveGame)
            if(var(VAR_RESULT) == YES)
            {
                message(format("{JPN}どちらが ホストに なるか きめてね。\pもう ひとりは グループに さんかを\nえらんで ください。"))
                waitmessage

                multichoice(16, 6, MULTI_LINK_HOST_JOIN, FALSE)

                switch(var(VAR_RESULT))
                {
                    case 0: // Join
                        message(format("{JPN}ローグアシスタントで せっていして ください\n… … Bボタン: やめる"))
                        waitmessage

                        special(Rogue_JoinMultiplayer)
                        waitstate

                        if(var(VAR_RESULT) == TRUE)
                        {
                            msgbox(format("{JPN}じゅんび かんりょう!\nぼうけんを たのしんでね!"))
                        }

                    case 1: // Host
                        message(format("{JPN}ローグアシスタントで せっていして ください\n… … Bボタン: やめる"))
                        waitmessage

                        special(Rogue_HostMultiplayer)
                        waitstate

                        if(var(VAR_RESULT) == TRUE)
                        {
                            msgbox(format("{JPN}じゅんび かんりょう!\nともだちが ぼうけんに さんかできるよ!"))
                        }

                    case 2: // Exit
                        setvar(VAR_RESULT, FALSE)

                }
            }
        }

        if(var(VAR_RESULT) == FALSE)
        {
            special(Rogue_GetLastMultiplayerConnectError)
            
            switch(var(VAR_RESULT))
            {
                case 1: // CONN_ERR_WRONG_GAME_FLAVOUR
                    poryswitch(ROGUE_VERSION)
                    {
                        ROGUE_VERSION_VANILLA
                        {
                            msgbox(format("{JPN}ごめんね。 あいてが つうじょうばんでは ないので\nつなげられないんだ。"))
                        }
                        ROGUE_VERSION_EXPANSION
                        {
                            msgbox(format("{JPN}ごめんね。 あいてが EXばんでは ないので\nつなげられないんだ。"))
                        }
                    }

                case 2: // CONN_ERR_WRONG_SAVE_VERSION
                    msgbox(format("{JPN}ごめんね。 あいてと バージョンが ちがうので\nつなげられないんだ。"))

                case 3: // CONN_ERR_WRONG_REVISED_MODE
                    msgbox(format("{JPN}ごめんね。 せっていラボの リビジョンモードが\nあわないので つなげられないんだ。"))

                default: // CONN_ERR_NONE
                    msgbox(format("{JPN}きが かわったら また こえを かけてね。"))

            }
        }
    }

    release
}

script Rogue_Interior_PokeConnect_TalkNurseBox
{
    lock

    msgbox(format("{JPN}やあ {PLAYER}!"))

    setvar(VAR_RESULT, 1)

    while(var(VAR_RESULT) == 1)
    {
        message(format("{JPN}かくちょう ポケモンボックスを つかいますか?"))
        waitmessage

        multichoice(20, 6, MULTI_YESNOINFO, NO)

        switch(var(VAR_RESULT))
        {
            case 0: // Yes
                call(Rogue_Interior_PokeConnect_ConnectHomeBox)
                setvar(VAR_RESULT, 0)

            case 1: // No
            case MULTI_B_PRESSED:
                setvar(VAR_RESULT, 0)

            case 2: // Info
                msgbox(format("{JPN}ローグアシスタントに つなぐと\nポケモンホームのような かくちょう\lボックスが つかえて もっと たくさんの\lポケモンを あずけられるよ!"), MSGBOX_DEFAULT)
                setvar(VAR_RESULT, 1)
        }
    }

    msgbox(format("{JPN}きを つけてね!"))
    release
}

script Rogue_Interior_PokeConnect_ConnectHomeBox
{
    call(Rogue_Common_WaitForRogueAssistant)
    
    if(var(VAR_RESULT) == TRUE)
    {
        call(Common_EventScript_SaveGame)
        if(var(VAR_RESULT) == YES)
        {
            special(Special_ViewAssistantBox)
            waitstate

            call(Common_EventScript_ForceSaveGame)
        }
    }
}

script Rogue_Interior_PokeConnect_Tutorial
{
    setflag(FLAG_ROGUE_ASSISTANT_TUTORIAL)
    setvar(VAR_STOP_TUTORIAL, 1)

    lock
    msgbox(format("{JPN}この たてものでは かくちょうボックスや\nマルチプレイが つかえる。\pいまのところ Windowsの mGBAでのみ\nたいおうして いる。\pつかうには ローグアシスタントという\nプログラムを ダウンロードして\lエミュレータに つなぐ ひつようが ある。\pダウンロードは:\n{COLOR BLUE}{ENG}https://rogue.assist.pokabbie.com{JPN}\p{COLOR RED}ほかの リンクからは ぜったいに\nダウンロードしないこと! ウイルスの\lきけんが あります!"))
    release
}