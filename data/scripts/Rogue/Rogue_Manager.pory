script Rogue_SetDesiredWeather
{
    if(var(VAR_ROGUE_DESIRED_WEATHER) != WEATHER_NONE)
    {
        setweather(VAR_ROGUE_DESIRED_WEATHER)
        doweather
    }
}

script Rogue_ClearWeather
{
    setweather(WEATHER_NONE)
    doweather
}

