script RogueHub_EnterSafari
{
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)

    showmoneybox(0, 0)
    msgbox(format("{JPN}サファリゾーンへ ようこそ!\nはいりますか?"), MSGBOX_YESNO)

    setvar(VAR_0x8000, 0)
    setvar(VAR_0x8001, 0)

    if(var(VAR_RESULT) == YES)
    {
        //questcollected(QUEST_Collector2)
        if(var(VAR_RESULT) == YES)
        {
            msgbox(format("{JPN}すべての せだいの ポケモンを\nだすことも できますし\lせだいを ひとつ えらぶことも\lできます。\pひとつの せだいに しぼりますか?"), MSGBOX_YESNO)

            if(var(VAR_RESULT) == YES)
            {
                message(format("{JPN}どの せだいに しますか?"))
                waitmessage
                
                if(flag(FLAG_ROGUE_EXPANSION_ACTIVE) && flag(FLAG_ROGUE_MET_POKABBIE))
                {
                    multichoice(20, 0, MULTI_GENERATIONS_UPTO9, NO)
                }
                else
                {
                    multichoice(20, 6, MULTI_GENERATIONS_UPTO3, NO)
                }

                switch(var(VAR_RESULT))
                {
                    case MULTI_B_PRESSED: 
                        setvar(VAR_ROGUE_SAFARI_GENERATION, 0)
                    
                    default:
                        copyvar(VAR_ROGUE_SAFARI_GENERATION, VAR_RESULT)
                        addvar(VAR_ROGUE_SAFARI_GENERATION, 1)
                }
            }
            else
            {
                setvar(VAR_ROGUE_SAFARI_GENERATION, 0)
            }
        }

        bufferitemname(STR_VAR_1, ITEM_SAFARI_BALL)
        message(format("{JPN}{STR_VAR_1}を いくつに しますか?"))
        waitmessage
        
        multichoice(20, 6, MULTI_MECHADOLL1_Q1, NO)

        switch(var(VAR_RESULT))
        {
            case 0:
                setvar(VAR_0x8000, 3)
                setvar(VAR_0x8001, 1000)
                call(RogueHub_EnterSafari1)

            case 1:
                setvar(VAR_0x8000, 6)
                setvar(VAR_0x8001, 1800)
                call(RogueHub_EnterSafari1)

            case 2:
                setvar(VAR_0x8000, 9)
                setvar(VAR_0x8001, 2500)
                call(RogueHub_EnterSafari1)

            case MULTI_B_PRESSED: 
                setvar(VAR_RESULT, NO)
        }
    }
    
    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("{JPN}また いつでも どうぞ。"))
        
        closemessage
        hidemoneybox
        applymovement(OBJ_EVENT_ID_PLAYER, Route121_SafariZoneEntrance_Movement_BackAwayFromCounter)
        waitmovement(0)
    }

    releaseall
}

script RogueHub_EnterSafari1
{
    checkmoney(VAR_0x8001)
    buffernumberstring(STR_VAR_1, VAR_0x8001)

    if(var(VAR_RESULT) == NO)
    {
        msgbox(format("{JPN}{STR_VAR_1}¥に なります。"))
        msgbox(format("{JPN}おや…\nいまは おかねが たりないようです。"))
    }
    else
    {
        msgbox(format("{JPN}{STR_VAR_1}¥に なります。\nはいりますか?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES)
        {
            playse(SE_SHOP)
            removemoney(VAR_0x8001)
            updatemoneybox
            msgbox(format("{JPN}たのしんでね!"))

            closemessage
            hidemoneybox
            applymovement(OBJ_EVENT_ID_PLAYER, Route121_SafariZoneEntrance_Movement_EnterSafariZone)
            waitmovement(0)
            special(EnterSafariMode)
            setvar(VAR_SAFARI_ZONE_STATE, 2)
            clearflag(FLAG_GOOD_LUCK_SAFARI_ZONE)
            warp(MAP_SAFARI_ZONE_SOUTH, 32, 33)
            waitstate
        }
    }
}

script RogueHub_HintSafariShinies
{
    lock
    faceplayer

    msgbox(format("{JPN}サファリゾーンの スタッフは\nとても ねっしんだ!\pぼうけんで つかまえた いろちがいを\nきろくして いてくれる!\pだから ぼうけんで いろちがいを\nつかまえたら サファリゾーンで\lかんたんに みつけられる!\pなにを つかまえたか わすれたら\nうしろの リストを みてくれ。\pなんて ねっしんな スタッフだ!"), MSGBOX_DEFAULT)

    release
}

script RogueHub_ListSafariShinies
{
    lock

    setvar(VAR_0x8004, 0)
    msgbox(format("{JPN}かいてある…\pいろちがい はんしょくプログラム:"), MSGBOX_DEFAULT)

    msgbox(format("{JPN}この きのうは いま つくりなおしちゅう\pこの ぶんが みえているなら アビーが うっかりして つくりなおしを わすれています"), MSGBOX_DEFAULT)

